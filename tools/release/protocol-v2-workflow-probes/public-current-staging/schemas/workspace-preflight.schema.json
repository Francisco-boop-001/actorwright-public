          "bodySidecars",
          "generatedPlugins",
          "generatedSidecars",
          "assetProviderCount",
          "runtimeAuthority",
          "diagnostics"
        ],
        "properties": {
          "schemaVersion": {
            "const": "2"
          },
          "edition": {
            "const": "skyrimse"
          },
          "isAccepted": {
            "const": true
          },
          "workspaceRoot": {
            "$ref": "#/$defs/workspacePath"
          },
          "dataRoot": {
            "$ref": "#/$defs/workspacePath"
          },
          "loadOrderPath": {
            "$ref": "#/$defs/workspacePath"
          },
          "outputRoot": {
            "$ref": "#/$defs/workspacePath"
          },
          "loadOrderHash": {
            "$ref": "#/$defs/sha256"
          },
