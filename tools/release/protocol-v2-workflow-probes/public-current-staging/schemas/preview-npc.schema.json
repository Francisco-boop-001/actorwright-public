                "type": "string",
                "minLength": 1
              },
              "imagePath": {
                "type": "string",
                "minLength": 1
              },
              "imageSha256": {
                "type": "string",
                "pattern": "^[0-9A-F]{64}$"
              },
              "roleMaskPath": {
                "type": "string",
                "minLength": 1
              },
              "roleMaskSha256": {
                "type": "string",
                "pattern": "^[0-9A-F]{64}$"
              },
              "width": {
                "const": 900
              },
              "height": {
                "const": 900
              }
            }
          },
          "diagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "severity",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "error"
