<UserControl x:Class="NpcManager.Desktop.SkyrimFaceEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Edit Skyrim NPC face task">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,16,10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="590" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        Background="#13252C" BorderBrush="#2F665E">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="FACE EDITOR  /  COMPLETE APPEARANCE" />
                        <TextBlock Margin="0,5,0,7" FontSize="23" FontWeight="SemiBold"
                                   Text="Edit one complete Skyrim face transaction" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Load an exact source-owned NPC, use the six-section modal and typed pickers, then review one hash-bound proposal before any ESP write." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="1  LOAD COMPLETE SOURCE" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Reviewed source plugin" />
                                <TextBox Text="{Binding SourcePlugin, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Face source plugin" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,5"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Text="NPC FormID" />
                                <TextBox Text="{Binding NpcFormId, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Face NPC FormID" />
                            </StackPanel>
                        </Grid>
                        <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource QuietButton}"
                                Content="_Load face and catalogs"
                                Command="{Binding LoadCommand}"
                                automation:AutomationProperties.Name="Load complete face document" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding Context}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="2  EDIT SIX SECTIONS" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding ReadinessText}" TextWrapping="Wrap" />
                        <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}"
                                Content="Open _face editor"
                                IsEnabled="{Binding CanOpenEditor}"
                                Click="OpenFaceEditor_Click"
                                automation:AutomationProperties.Name="Open six-section face editor" />
                        <Border Margin="0,14,0,0" Padding="10"
                                Background="#201B13" BorderBrush="#6B532A"
                                BorderThickness="1" CornerRadius="7">
                            <TextBlock Foreground="#E5B96A" TextWrapping="Wrap"
                                       Text="RaceMenu mask paths, custom morphs, sculpt, face overlays, explicit HCLF clear, and CharGen-flag changes fail closed at the plugin projection boundary." />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="3  REVIEW DECLARED SURFACE" />
                        <ListView Margin="0,10,0,0" MinHeight="120"
                                  ItemsSource="{Binding Changes}"
                                  Background="#0E1924" BorderBrush="#294052"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  automation:AutomationProperties.Name="Reviewed face subrecord surfaces">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="#13252C" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="BorderBrush" Value="#294052" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Subrecord" Width="120"
                                                    DisplayMemberBinding="{Binding Subrecord}" />
                                    <GridViewColumn Header="Before" Width="235"
                                                    DisplayMemberBinding="{Binding Before}" />
                                    <GridViewColumn Header="After" Width="235"
                                                    DisplayMemberBinding="{Binding After}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="FRESH OUTPUTS" />
                        <TextBlock Margin="0,8,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Proposal JSON" />
                        <TextBox Text="{Binding ProposalPath, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Face proposal path" />
                        <TextBlock Margin="0,10,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Differently named output ESP" />
                        <TextBox Text="{Binding OutputPlugin, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Face output plugin path" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="REVIEW, WRITE, VERIFY" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}"
                                Content="_Review face proposal"
                                Command="{Binding ReviewCommand}"
                                automation:AutomationProperties.Name="Review face proposal" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}"
                                Content="_Write and verify ESP"
                                Command="{Binding ExecuteCommand}"
                                automation:AutomationProperties.Name="Write and verify fresh face plugin" />
                        <Button Margin="0,10,0,0" Style="{StaticResource QuietButton}"
                                Content="_Cancel operation"
                                Command="{Binding CancelCommand}"
                                automation:AutomationProperties.Name="Cancel face operation" />
                        <ProgressBar Margin="0,18,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     automation:AutomationProperties.Name="Face edit progress" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="RESULT" />
                        <TextBlock Margin="0,5,0,12" FontSize="19" FontWeight="SemiBold"
                                   Text="{Binding Verdict}" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Proposal SHA-256" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ProposalSha256}"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Output plugin" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ResultPlugin}"
                                   TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Output SHA-256" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding OutputSha256}"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,14,0,0" Padding="10"
                                Background="{DynamicResource AccentDarkBrush}" CornerRadius="7">
                            <TextBlock Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"
                                       Text="Runtime, FaceGen, texture-render, and visual authority remain false after static readback." />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="DIAGNOSTICS" />
                        <ListBox Margin="0,10,0,0" MaxHeight="210"
                                 ItemsSource="{Binding Diagnostics}"
                                 automation:AutomationProperties.Name="Face edit diagnostics" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
