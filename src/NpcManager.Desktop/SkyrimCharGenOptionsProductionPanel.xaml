<UserControl x:Class="NpcManager.Desktop.SkyrimCharGenOptionsProductionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Edit and consume Skyrim CharGen options">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,16,10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="620" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="2*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        Background="#13252C" BorderBrush="#2F665E">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="CHARGEN OPTIONS  /  NATIVE FACETINT" />
                        <TextBlock Margin="0,5,0,7" FontSize="23" FontWeight="SemiBold"
                                   Text="Edit, persist, and prove consumption" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Reviews one exact Skyrim options artifact. The modal returns one immutable document; Review writes proposal JSON only; Apply writes and reopens canonical options plus one native FaceTint DDS." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="1  EXACT OPENING OPTIONS" />
                        <TextBlock Margin="0,10,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="K-local options JSON" />
                        <TextBox Text="{Binding SourceOptions, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="CharGen source options path" />
                        <TextBlock Margin="0,10,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Expected SHA-256" />
                        <TextBox Text="{Binding SourceOptionsSha256, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="CharGen source options SHA-256" />
                        <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource QuietButton}"
                                Content="_Review exact source"
                                Command="{Binding LoadCommand}"
                                automation:AutomationProperties.Name="Review exact CharGen source" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="2  IMMUTABLE OPTIONS DOCUMENT" />
                        <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}"
                                Content="_Open CharGen options editor"
                                IsEnabled="{Binding CanOpenEditor}"
                                Click="OpenOptionsEditor_Click"
                                automation:AutomationProperties.Name="Open Skyrim CharGen options editor" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding DocumentSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="3  COPIED NATIVE AUTHORITY" />
                        <TextBlock Margin="0,10,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Copied Skyrim Data root" />
                        <TextBox Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="CharGen copied Data root" />
                        <TextBlock Margin="0,10,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Plugin order (one per line)" />
                        <TextBox MinHeight="54" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding PluginOrder, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="CharGen copied plugin order" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                           Text="NPC Plugin|FormID" />
                                <TextBox Margin="0,4,0,0"
                                         Text="{Binding NpcReference, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="CharGen NPC reference" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Race Plugin|FormID" />
                                <TextBox Margin="0,4,0,0"
                                         Text="{Binding ExpectedRace, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="CharGen expected race reference" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,10,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Expected NPC sex" />
                        <ComboBox Width="180" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SexOptions}"
                                  SelectedItem="{Binding ExpectedSex}"
                                  automation:AutomationProperties.Name="CharGen expected NPC sex" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="FRESH OUTPUTS" />
                        <TextBlock Margin="0,8,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Fresh proposal JSON" />
                        <TextBox Text="{Binding ProposalPath, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="CharGen production proposal path" />
                        <TextBlock Margin="0,12,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Fresh owned output directory" />
                        <TextBox Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="CharGen production output root" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="4  REVIEW, WRITE, REOPEN" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}"
                                Content="_Review options proposal"
                                Command="{Binding ReviewCommand}"
                                automation:AutomationProperties.Name="Review CharGen production proposal" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}"
                                Content="_Write, bake, and verify"
                                Command="{Binding ApplyCommand}"
                                automation:AutomationProperties.Name="Write bake and verify CharGen options" />
                        <Button Margin="0,10,0,0" Style="{StaticResource QuietButton}"
                                Content="_Cancel operation"
                                Command="{Binding CancelCommand}"
                                automation:AutomationProperties.Name="Cancel CharGen production operation" />
                        <ProgressBar Margin="0,18,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     automation:AutomationProperties.Name="CharGen production progress" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="RESULT" />
                        <TextBlock Margin="0,5,0,12" FontSize="19" FontWeight="SemiBold"
                                   Text="{Binding Verdict}" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Proposal SHA-256" />
                        <TextBlock Margin="0,4,0,9" Text="{Binding ProposalSha256}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Canonical options" />
                        <TextBlock Margin="0,4,0,4" Text="{Binding OptionsArtifact}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,9" Text="{Binding OptionsSha256}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Native FaceTint" />
                        <TextBlock Margin="0,4,0,4" Text="{Binding FaceTintArtifact}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,9" Text="{Binding FaceTintSha256}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Consumption receipt SHA-256" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding ReceiptSha256}" TextWrapping="Wrap" />
                        <Border Margin="0,14,0,0" Padding="10"
                                Background="{DynamicResource AccentDarkBrush}" CornerRadius="7">
                            <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                       Text="Static DDS readback proves file production, not that Skyrim loaded or rendered this provider." />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="DIAGNOSTICS" />
                        <ListBox Margin="0,10,0,0" MaxHeight="190"
                                 ItemsSource="{Binding Diagnostics}"
                                 automation:AutomationProperties.Name="CharGen production diagnostics" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
