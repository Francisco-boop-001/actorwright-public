<Window x:Class="NpcManager.Desktop.SkyrimSelectiveAppearancePasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Paste selected appearance"
        Width="980" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=SelectAllButton}"
        automation:AutomationProperties.Name="Choose Skyrim appearance categories to paste">
    <Window.Resources>
        <DataTemplate x:Key="PasteOptionTemplate">
            <Border Margin="0,0,0,8" Padding="12,10"
                    Background="#101A25" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          VerticalContentAlignment="Top"
                          automation:AutomationProperties.Name="{Binding Title}"
                          automation:AutomationProperties.HelpText="{Binding Description}">
                    <StackPanel Margin="7,0,0,0">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                        <TextBlock Margin="0,3,0,0" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </CheckBox>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource EyebrowText}"
                       Text="SELECTIVE SKYRIM APPEARANCE PASTE" />
            <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"
                       Text="Choose what moves to the target" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap">
                <Run Text="{Binding SourceLabel, Mode=OneWay}" />
                <Run Text="  to  " />
                <Run Text="{Binding TargetLabel, Mode=OneWay}" />
                <Run Text=". Unchecked categories remain exactly as they are." />
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14,11"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SelectAllButton" MinWidth="110"
                        Style="{StaticResource QuietButton}" Content="Select _all"
                        Click="SelectAll_OnClick"
                        automation:AutomationProperties.Name="Select all Skyrim appearance categories" />
                <Button Grid.Column="1" MinWidth="120" Margin="8,0,0,0"
                        Style="{StaticResource QuietButton}" Content="Select _none"
                        Click="DeselectAll_OnClick"
                        automation:AutomationProperties.Name="Deselect all Skyrim appearance categories" />
                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                               Text="{Binding SelectionSummary}"
                               automation:AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,3,0,0" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding NoSelectionNotice}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      automation:AutomationProperties.Name="Appearance category groups">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="210" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="210" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="210" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="BODY" />
                        <TextBlock Margin="0,4,0,12" FontSize="17" FontWeight="SemiBold"
                                   Text="Shape and surface" />
                        <ItemsControl ItemsSource="{Binding BodyOptions}"
                                      ItemTemplate="{StaticResource PasteOptionTemplate}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="FACE" />
                        <TextBlock Margin="0,4,0,12" FontSize="17" FontWeight="SemiBold"
                                   Text="Identity and detail" />
                        <ItemsControl ItemsSource="{Binding FaceOptions}"
                                      ItemTemplate="{StaticResource PasteOptionTemplate}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="NPC RECORD" />
                        <TextBlock Margin="0,4,0,12" FontSize="17" FontWeight="SemiBold"
                                   Text="Record-owned choices" />
                        <ItemsControl ItemsSource="{Binding RecordOptions}"
                                      ItemTemplate="{StaticResource PasteOptionTemplate}" />
                        <Border Margin="0,8,0,0" Padding="12" CornerRadius="8"
                                Background="#171D24"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1">
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding AuthorityNotice}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Orientation="Horizontal">
                <Button MinWidth="110" Style="{StaticResource QuietButton}"
                        Content="_Cancel" IsCancel="True" Click="Cancel_OnClick"
                        automation:AutomationProperties.Name="Cancel selective appearance paste" />
                <Button MinWidth="160" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="_Paste selected" IsDefault="True" Click="Paste_OnClick"
                        automation:AutomationProperties.Name="Paste selected Skyrim appearance categories" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
