<Window x:Class="NpcManager.Desktop.AnimationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Choose an animation"
        Width="1060" Height="720" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        automation:AutomationProperties.Name="Choose an animation">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowText}" Text="ANIMATION CATALOG" />
                <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"
                           Text="Choose the preview motion" />
                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding TargetSummary}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="13,7" VerticalAlignment="Center"
                    Background="{DynamicResource AccentDarkBrush}"
                    BorderBrush="{DynamicResource AccentStrongBrush}"
                    BorderThickness="1" CornerRadius="16">
                <TextBlock Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                           Text="Static catalog metadata" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                               Text="Catalog file" />
                    <TextBlock Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas"
                               FontSize="11" Text="{Binding ManifestPath}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                               Text="SHA-256 authority" />
                    <TextBlock Margin="0,4,0,0" FontFamily="Cascadia Mono, Consolas"
                               FontSize="11" Text="{Binding ManifestHash}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,14" Padding="14"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" Margin="0,0,18,0"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotBusy}"
                         automation:AutomationProperties.Name="Filter animations" />
                <CheckBox Grid.Column="1" Margin="0,9,18,0"
                          Content="Match current NPC sex"
                          IsChecked="{Binding FilterByGender}"
                          IsEnabled="{Binding IsNotBusy}"
                          automation:AutomationProperties.Name="Filter animations for current NPC sex" />
                <CheckBox Grid.Column="2" Margin="0,9,0,0"
                          Content="Show first-person and camera clips"
                          IsChecked="{Binding ShowFirstPerson}"
                          IsEnabled="{Binding IsNotBusy}"
                          automation:AutomationProperties.Name="Show first-person and camera animations" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" MinWidth="430" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.9*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <TreeView x:Name="AnimationTree"
                              ItemsSource="{Binding Groups}"
                              IsEnabled="{Binding IsNotBusy}"
                              Background="#0F1823"
                              SelectedItemChanged="AnimationTree_OnSelectedItemChanged"
                              MouseDoubleClick="AnimationTree_OnMouseDoubleClick"
                              PreviewKeyDown="AnimationTree_OnPreviewKeyDown"
                              automation:AutomationProperties.Name="Animation hierarchy">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="automation:AutomationProperties.Name"
                                        Value="{Binding AutomationName}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxWidth="300" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="No animations match these filters. Clear the search or broaden the switches."
                               Visibility="{Binding HasNoVisibleClips, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar Height="3" VerticalAlignment="Bottom"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowText}" Text="SELECTED CLIP" />
                    <TextBlock Margin="0,5,0,10" FontSize="23" FontWeight="SemiBold"
                               Text="{Binding SelectionTitle}" TextWrapping="Wrap" />
                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding SelectionPath}" TextWrapping="Wrap" />
                    <Border Margin="0,18,0,12" Padding="14" Background="#0E1924"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Playback metadata" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectionMetadata}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Padding="14" Background="#0E1924" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Authority and route" />
                            <TextBlock Margin="0,6,0,0" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding SelectionAuthority}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                       Text="{Binding Status}" TextWrapping="Wrap"
                       automation:AutomationProperties.LiveSetting="Polite" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button MinWidth="110" Style="{StaticResource QuietButton}" Content="_Cancel"
                        IsCancel="True" Click="Cancel_OnClick"
                        automation:AutomationProperties.Name="Cancel animation selection" />
                <Button MinWidth="150" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="_Select animation" IsDefault="True"
                        IsEnabled="{Binding CanAccept}" Click="Accept_OnClick"
                        automation:AutomationProperties.Name="Select animation" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
