<Window x:Class="NpcManager.Desktop.SkyrimBodyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{Binding Title}"
        Width="1180" Height="790" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        automation:AutomationProperties.Name="Skyrim body editor">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowText}" Text="SKYRIM APPEARANCE  /  LOSSLESS BODY TRANSACTION" />
                <TextBlock Margin="0,5,0,0" FontSize="29" FontWeight="SemiBold"
                           Text="Shape the body without erasing the preset" />
                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Context}" />
            </StackPanel>
            <Border Grid.Column="1" MaxWidth="405" Padding="13" CornerRadius="9"
                    Background="#171D24" BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1">
                <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}"
                           Text="{Binding AuthorityNotice}" TextWrapping="Wrap"
                           automation:AutomationProperties.Name="Body editor authority notice" />
            </Border>
        </Grid>

        <TabControl x:Name="BodyTabs" Grid.Row="2"
                    SelectionChanged="Tabs_OnSelectionChanged"
                    automation:AutomationProperties.Name="Skyrim body editor sections">
            <TabItem Header="Weight">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}" Padding="22">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Vanilla NPC weight (NAM7)" />
                            <TextBlock Margin="0,8,0,20" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="One independent value from 0 to 100. It does not select a body mesh or skin provider."
                                       TextWrapping="Wrap" />
                            <Slider Minimum="0" Maximum="100" TickFrequency="1"
                                    Value="{Binding Weight.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    automation:AutomationProperties.Name="Skyrim NPC NAM7 weight" />
                            <TextBox Margin="0,10,0,0" Width="120" HorizontalAlignment="Left"
                                     Text="{Binding Weight.Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                     automation:AutomationProperties.Name="Exact Skyrim NPC weight" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="Authority boundary" />
                            <TextBlock Margin="0,10,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding Weight.Authority}" TextWrapping="Wrap"
                                       automation:AutomationProperties.Name="Weight authority status" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="BodySlide">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BodySlide.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Filter BodySlide sliders" />
                        <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" Text="{Binding BodySlide.CatalogStatus}" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BodySlide.Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="145" /><ColumnDefinition /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Authority}" />
                                                <Slider Grid.Column="2" Minimum="0" Maximum="100" TickFrequency="1"
                                                        Value="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        automation:AutomationProperties.Name="{Binding Name}" />
                                                <TextBox Grid.Column="3" Margin="9,0,0,0"
                                                         Text="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F2}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="{Binding BodySlide.EmptyState}"
                                       Visibility="{Binding BodySlide.HasNoRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       automation:AutomationProperties.Name="BodySlide empty state" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Node transforms">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.35*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Transforms.CatalogStatus}" TextWrapping="Wrap" />
                            <ListView Grid.Row="1" Margin="0,10,0,0"
                                      ItemsSource="{Binding Transforms.Rows}"
                                      SelectedItem="{Binding Transforms.SelectedRow}"
                                      KeyDown="Transforms_KeyDown"
                                      automation:AutomationProperties.Name="RaceMenu node transform identities">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Node" Width="230" DisplayMemberBinding="{Binding Node}" />
                                        <GridViewColumn Header="View" Width="100" DisplayMemberBinding="{Binding Perspective}" />
                                        <GridViewColumn Header="Authority" Width="180" DisplayMemberBinding="{Binding Authority}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Exact node identity" />
                                <Grid Margin="0,8,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Transforms.NodeName, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Transform node name" />
                                    <CheckBox Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding Transforms.FirstPerson}" Content="First person"
                                              automation:AutomationProperties.Name="Transform first-person identity" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Transforms.HasScale}" Content="Uniform scale" />
                                    <TextBox Grid.Column="1" IsEnabled="{Binding Transforms.HasScale}"
                                             Text="{Binding Transforms.Scale, UpdateSourceTrigger=LostFocus, StringFormat=F4}"
                                             automation:AutomationProperties.Name="Transform scale" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Transforms.HasScaleMode}" Content="Scale mode (0–3)" />
                                    <TextBox Grid.Column="1" IsEnabled="{Binding Transforms.HasScaleMode}"
                                             Text="{Binding Transforms.ScaleMode, UpdateSourceTrigger=LostFocus}"
                                             automation:AutomationProperties.Name="Transform scale mode" />
                                </Grid>
                                <CheckBox Margin="0,2,0,7" IsChecked="{Binding Transforms.HasPosition}" Content="Position X / Y / Z" />
                                <UniformGrid Columns="3" IsEnabled="{Binding Transforms.HasPosition}">
                                    <TextBox Margin="0,0,7,0" Text="{Binding Transforms.PositionX, UpdateSourceTrigger=LostFocus, StringFormat=F4}" automation:AutomationProperties.Name="Position X" />
                                    <TextBox Margin="0,0,7,0" Text="{Binding Transforms.PositionY, UpdateSourceTrigger=LostFocus, StringFormat=F4}" automation:AutomationProperties.Name="Position Y" />
                                    <TextBox Text="{Binding Transforms.PositionZ, UpdateSourceTrigger=LostFocus, StringFormat=F4}" automation:AutomationProperties.Name="Position Z" />
                                </UniformGrid>
                                <CheckBox Margin="0,16,0,7" IsChecked="{Binding Transforms.HasRotation}" Content="Canonical 3×3 rotation matrix" />
                                <ItemsControl ItemsSource="{Binding Transforms.RotationCells}" IsEnabled="{Binding Transforms.HasRotation}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,7,7">
                                                <TextBlock FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Label}" />
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat=F5}"
                                                         automation:AutomationProperties.Name="{Binding Label}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,3,0,12" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Matrix storage is retained because this gate does not guess RaceMenu's Euler convention." TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Apply transform" Click="ApplyTransform_Click" />
                                    <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Content="Reset selected node"
                                            IsEnabled="{Binding Transforms.CanReset}" Click="ResetTransform_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Skin overrides">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ListView ItemsSource="{Binding SkinOverrides.Rows}"
                                      SelectedItem="{Binding SkinOverrides.SelectedRow}"
                                      KeyDown="SkinOverrides_KeyDown"
                                      automation:AutomationProperties.Name="RaceMenu skin overrides">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Slot mask" Width="115" DisplayMemberBinding="{Binding SlotMaskText}" />
                                        <GridViewColumn Header="View" Width="100" DisplayMemberBinding="{Binding Perspective}" />
                                        <GridViewColumn Header="Payload" Width="285" DisplayMemberBinding="{Binding Summary}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" CornerRadius="7" Background="#151B22">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Add explicit override" />
                                    <Grid Margin="0,7,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SkinOverrides.NewSlotMask}" automation:AutomationProperties.Name="New skin slot mask" />
                                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding SkinOverrides.NewDiffuse}" automation:AutomationProperties.Name="New skin diffuse DDS" />
                                        <CheckBox Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SkinOverrides.NewFirstPerson}" Content="First person" />
                                    </Grid>
                                    <Button HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Content="Add override" Click="AddSkinOverride_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding SkinOverrides.CanEdit}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Engine-effective texture slots" />
                                <TextBlock Margin="0,5,0,10" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Only 0, 1, 2, and 7 are edited here. Every other preset-carried slot remains preserved." TextWrapping="Wrap" />
                                <TextBlock Text="Diffuse · slot 0" /><TextBox Margin="0,4,0,8" Text="{Binding SkinOverrides.Diffuse}" />
                                <TextBlock Text="Normal · slot 1" /><TextBox Margin="0,4,0,8" Text="{Binding SkinOverrides.Normal}" />
                                <TextBlock Text="Subsurface / SK · slot 2" /><TextBox Margin="0,4,0,8" Text="{Binding SkinOverrides.Subsurface}" />
                                <TextBlock Text="Specular · slot 7" /><TextBox Margin="0,4,0,12" Text="{Binding SkinOverrides.Specular}" />
                                <CheckBox IsChecked="{Binding SkinOverrides.TintEnabled}" Content="Tint key 7 enabled" />
                                <UniformGrid Margin="0,6,0,10" Columns="4" IsEnabled="{Binding SkinOverrides.TintEnabled}">
                                    <TextBox Margin="0,0,6,0" Text="{Binding SkinOverrides.Red}" automation:AutomationProperties.Name="Skin tint red" />
                                    <TextBox Margin="0,0,6,0" Text="{Binding SkinOverrides.Green}" automation:AutomationProperties.Name="Skin tint green" />
                                    <TextBox Margin="0,0,6,0" Text="{Binding SkinOverrides.Blue}" automation:AutomationProperties.Name="Skin tint blue" />
                                    <TextBox Text="{Binding SkinOverrides.TintAlpha}" automation:AutomationProperties.Name="Skin tint alpha" />
                                </UniformGrid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="155" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding SkinOverrides.AlphaEnabled}" Content="Opacity key 8 enabled" />
                                    <TextBox Grid.Column="1" IsEnabled="{Binding SkinOverrides.AlphaEnabled}" Text="{Binding SkinOverrides.Alpha}" automation:AutomationProperties.Name="Skin opacity" />
                                </Grid>
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Apply override" Click="ApplySkinOverride_Click" />
                                    <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Content="Remove"
                                            Click="RemoveSkinOverride_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Body paint">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding BodyOverlays.Targets}" SelectedItem="{Binding BodyOverlays.SelectedTarget}"
                                          DisplayMemberPath="Label" automation:AutomationProperties.Name="Body paint zone" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource QuietButton}" Content="Add registered paint..." Click="AddBodyPaint_Click" />
                            </Grid>
                            <ListView Grid.Row="1" Margin="0,10,0,10" ItemsSource="{Binding BodyOverlays.Rows}"
                                      SelectedItem="{Binding BodyOverlays.SelectedRow}" KeyDown="BodyOverlays_KeyDown"
                                      automation:AutomationProperties.Name="Applied Body Hands and Feet paint">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Node and paint" Width="300" DisplayMemberBinding="{Binding Label}" />
                                        <GridViewColumn Header="Normal" Width="220" DisplayMemberBinding="{Binding Normal}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding BodyOverlays.SlotStatus}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource QuietButton}" Content="Up" IsEnabled="{Binding BodyOverlays.CanMoveUp}" Click="MoveBodyPaintUp_Click" />
                                    <Button Margin="7,0,0,0" Style="{StaticResource QuietButton}" Content="Down" IsEnabled="{Binding BodyOverlays.CanMoveDown}" Click="MoveBodyPaintDown_Click" />
                                    <Button Margin="7,0,0,0" Style="{StaticResource QuietButton}" Content="Remove" IsEnabled="{Binding BodyOverlays.CanRemove}" Click="RemoveBodyPaint_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                        <StackPanel DataContext="{Binding BodyOverlays.SelectedRow}">
                            <TextBlock FontWeight="SemiBold" Text="Selected paint appearance" />
                            <TextBlock Margin="0,7,0,3" FontFamily="Cascadia Mono, Consolas" FontSize="11" Text="{Binding Diffuse}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,14" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Normal}" TextWrapping="Wrap" />
                            <CheckBox IsChecked="{Binding TintEnabled}" Content="Tint enabled" />
                            <UniformGrid Margin="0,8,0,14" Columns="3" IsEnabled="{Binding TintEnabled}">
                                <TextBox Margin="0,0,7,0" Text="{Binding Red}" automation:AutomationProperties.Name="Body paint tint red" />
                                <TextBox Margin="0,0,7,0" Text="{Binding Green}" automation:AutomationProperties.Name="Body paint tint green" />
                                <TextBox Text="{Binding Blue}" automation:AutomationProperties.Name="Body paint tint blue" />
                            </UniformGrid>
                            <TextBlock Text="Opacity" />
                            <Slider Margin="0,7,0,0" Minimum="0" Maximum="1" TickFrequency="0.01" Value="{Binding Opacity}" automation:AutomationProperties.Name="Body paint opacity" />
                            <TextBlock Margin="0,18,0,0" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="Body, Hands, and Feet are grouped separately. Moving paint never crosses zones; Face rows stay hidden and preserved." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Status}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Polite" automation:AutomationProperties.Name="Body editor status" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ValidationMessage}"
                           TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Assertive"
                           automation:AutomationProperties.Name="Body editor validation" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource QuietButton}" Content="Reset this section" Click="ResetSection_Click" />
                <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
                <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Content="Accept body document" Click="Accept_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
