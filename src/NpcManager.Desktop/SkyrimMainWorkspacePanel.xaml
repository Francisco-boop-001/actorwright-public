<UserControl x:Class="NpcManager.Desktop.SkyrimMainWorkspacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Integrated Skyrim NPC workspace">
    <Grid Margin="0,14,8,8"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          automation:AutomationProperties.Name="Main workspace viewport">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*" MinWidth="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="44*" MinWidth="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="26*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="REVIEWED WINNING RECORDS" />
                        <TextBlock Margin="0,5,0,12"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Text="NPC and leveled NPC browser" />
                        <Label Target="{Binding ElementName=SearchBox}"
                               Content="_Search" />
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Main workspace search" />
                        <Button Margin="0,10,0,0"
                                Command="{Binding LoadCommand}"
                                Content="_Reload reviewed records"
                                automation:AutomationProperties.Name="Reload reviewed NPC workspace" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,12,0,10">
                        <CheckBox Margin="0,0,12,6"
                                  Content="_NPC"
                                  IsChecked="{Binding ShowNpcs}"
                                  automation:AutomationProperties.Name="Show NPC records" />
                        <CheckBox Margin="0,0,12,6"
                                  Content="_LVLN"
                                  IsChecked="{Binding ShowLeveledNpcs}"
                                  automation:AutomationProperties.Name="Show leveled NPC records" />
                        <CheckBox Margin="0,0,12,6"
                                  Content="_Unique"
                                  IsChecked="{Binding ShowUnique}" />
                        <CheckBox Margin="0,0,12,6"
                                  Content="_Generic"
                                  IsChecked="{Binding ShowGeneric}" />
                        <CheckBox Margin="0,0,12,6"
                                  Content="_Template"
                                  IsChecked="{Binding ShowTemplate}" />
                        <CheckBox Margin="0,0,12,6"
                                  Content="Un_use_d"
                                  IsChecked="{Binding ShowUnused}" />
                        <CheckBox Margin="0,0,12,6"
                                  Content="_Changed only"
                                  IsChecked="{Binding ChangedOnly}" />
                        <CheckBox Margin="0,0,12,6"
                                  Content="Include _deleted"
                                  IsChecked="{Binding IncludeDeleted}" />
                        <Label Margin="0,0,6,0"
                               Target="{Binding ElementName=GenderFilter}"
                               Content="_Gender" />
                        <ComboBox x:Name="GenderFilter"
                                  Width="115"
                                  ItemsSource="{Binding GenderChoices}"
                                  SelectedItem="{Binding Gender}"
                                  automation:AutomationProperties.Name="Main workspace gender filter" />
                    </WrapPanel>

                    <ListBox x:Name="RecordsList"
                             Grid.Row="2"
                             ItemsSource="{Binding VisibleRows}"
                             SelectionMode="Extended"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="RecordsSelectionChanged"
                             PreviewMouseRightButtonDown="RecordsPreviewMouseRightButtonDown"
                             automation:AutomationProperties.Name="NPC and leveled NPC record browser">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,5">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Margin="8,0,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding KindText}" />
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding EditorId}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding Name}" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{Binding IdentityText}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="{Binding StateText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding VisibleCount, StringFormat=Visible: {0}}" />
                        <TextBlock Margin="16,0,0,0"
                                   Text="{Binding SelectedCount, StringFormat=Selected: {0}}" />
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              automation:AutomationProperties.Name="Main workspace preview viewport">
                    <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowText}"
                               Text="OFF-ENGINE PREVIEW" />
                    <TextBlock Margin="0,5,0,12"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Text="Hash-bound composed NPC render" />
                    <TextBlock Margin="0,0,0,10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding HighFidelityPreviewLabel}"
                               automation:AutomationProperties.Name="High fidelity preview authority label" />
                    <Border Margin="0,8,0,10"
                            Padding="8"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding NpcVisualPreviewTargetText}"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.Name="High fidelity NPC preview target" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="10"
                                       Text="{Binding NpcVisualPackageManifestPath, StringFormat=Package: {0}}"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.Name="Opened Manager package path" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="10"
                                       Text="{Binding NpcVisualPackageSha256, StringFormat=Manifest SHA-256: {0}}"
                                       TextWrapping="Wrap"
                                       automation:AutomationProperties.Name="Opened Manager package hash" />
                            <WrapPanel Margin="0,7,0,0">
                                <Button Margin="0,0,8,0"
                                        Click="OpenNpcVisualPackageForPreview"
                                        Content="_Open Manager package..."
                                        automation:AutomationProperties.Name="Open Manager package for high fidelity preview" />
                                <Button Click="ClearNpcVisualPackagePreview"
                                        Content="_Clear package target"
                                        automation:AutomationProperties.Name="Clear Manager package preview target" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border MinHeight="330"
                            Background="#0B1116"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1">
                        <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSource}}"
                               Stretch="Uniform"
                               automation:AutomationProperties.Name="Main workspace actual preview" />
                    </Border>
                    <TextBlock Margin="0,8,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding PreviewRouteText}" />

                    <ItemsControl Margin="0,10,0,0"
                                  ItemsSource="{Binding PreviewViews}"
                                  automation:AutomationProperties.Name="High fidelity face and body views">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="145"
                                            Margin="0,0,8,8">
                                    <Border Height="145"
                                            Background="#0B1116"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="1">
                                        <Image Source="{Binding ImagePath, Converter={StaticResource PathToImageSource}}"
                                               Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding Id}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Target="{Binding ElementName=PreviewModeBox}"
                                   Content="Preview _mode" />
                            <ComboBox x:Name="PreviewModeBox"
                                      ItemsSource="{Binding PreviewModeChoices}"
                                      SelectedItem="{Binding PreviewMode}"
                                      automation:AutomationProperties.Name="Main workspace preview mode" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Target="{Binding ElementName=PreviewGenderBox}"
                                   Content="Preview _gender" />
                            <ComboBox x:Name="PreviewGenderBox"
                                      ItemsSource="{Binding GenderChoices}"
                                      SelectedItem="{Binding PreviewGender}"
                                      automation:AutomationProperties.Name="Main workspace preview gender" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Target="{Binding ElementName=VariantText}"
                                   Content="Outfit _variant ID" />
                            <TextBox x:Name="VariantText"
                                     Text="{Binding PreviewVariantId, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Main workspace outfit variant" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Target="{Binding ElementName=SeedBox}"
                                   Content="_Reroll seed" />
                            <TextBox x:Name="SeedBox"
                                     Text="{Binding RerollSeed, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Main workspace reroll seed" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox Margin="0,0,12,6" Content="_Body"
                                  IsChecked="{Binding RenderBody}" />
                        <CheckBox Margin="0,0,12,6" Content="_Underarmor"
                                  IsChecked="{Binding RenderUnderarmor}" />
                        <CheckBox Margin="0,0,12,6" Content="_Armor"
                                  IsChecked="{Binding RenderArmor}" />
                        <CheckBox Margin="0,0,12,6" Content="_Headwear"
                                  IsChecked="{Binding RenderHeadwear}" />
                        <CheckBox Margin="0,0,12,6" Content="_Gore"
                                  IsChecked="{Binding RenderGore}" />
                        <CheckBox Margin="0,0,12,6" Content="Bone _morphs"
                                  IsChecked="{Binding ApplyBoneMorphs}" />
                        <CheckBox Margin="0,0,12,6" Content="_Vertex morphs"
                                  IsChecked="{Binding ApplyVertexMorphs}" />
                        <CheckBox Margin="0,0,12,6" Content="Body _weight"
                                  IsChecked="{Binding ApplyBodyWeight}" />
                        <CheckBox Margin="0,0,12,6" Content="_Sculpt"
                                  IsChecked="{Binding ApplySculpt}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Margin="0,0,8,8"
                                Command="{Binding RenderPreviewCommand}"
                                Content="_Render"
                                automation:AutomationProperties.Name="Render selected NPC preview" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding RefreshPreviewCommand}"
                                Content="Re_fresh"
                                automation:AutomationProperties.Name="Refresh selected NPC high fidelity preview" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding RerollCommand}"
                                Content="Re_roll"
                                automation:AutomationProperties.Name="Reroll selected NPC preview" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding LightingCommand}"
                                Content="_Lighting" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding AnimationCommand}"
                                Content="A_nimation" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding CancelCommand}"
                                Content="_Cancel active" />
                    </WrapPanel>

                    <TextBlock Margin="0,6,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding PreviewAuthorityText}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding PreviewSceneSha256, StringFormat=Scene SHA-256: {0}}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="{Binding PreviewImageSha256, StringFormat=Image SHA-256: {0}}" />

                    <Expander Margin="0,12,0,0"
                              Header="Reference and Skyrim runtime comparison (optional)">
                        <StackPanel Margin="0,8,0,0">
                            <Label Target="{Binding ElementName=ReferenceComparisonPath}"
                                   Content="_Reference screenshot path" />
                            <TextBox x:Name="ReferenceComparisonPath"
                                     Text="{Binding ReferenceComparisonImagePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Margin="0,6,0,0"
                                   Target="{Binding ElementName=RuntimeComparisonPath}"
                                   Content="Skyrim _runtime screenshot path" />
                            <TextBox x:Name="RuntimeComparisonPath"
                                     Text="{Binding RuntimeComparisonImagePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ComparePreviewCommand}"
                                    Content="_Align and compare"
                                    automation:AutomationProperties.Name="Align preview with configured visual authorities" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        MinHeight="180"
                                        Background="#0B1116">
                                    <Image Source="{Binding ReferenceComparisonImagePath, Converter={StaticResource PathToImageSource}}"
                                           Stretch="Uniform" />
                                </Border>
                                <Border Grid.Column="2"
                                        MinHeight="180"
                                        Background="#0B1116">
                                    <Image Source="{Binding RuntimeComparisonImagePath, Converter={StaticResource PathToImageSource}}"
                                           Stretch="Uniform" />
                                </Border>
                            </Grid>
                            <ItemsControl Margin="0,10,0,0"
                                          ItemsSource="{Binding PreviewComparisons}"
                                          automation:AutomationProperties.Name="Aligned NPC preview comparisons">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding Label}" />
                                            <TextBlock Margin="0,2,0,5"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding MeanAbsoluteRgbDifference, StringFormat=Mean absolute RGB difference (regression evidence only): {0:F3}}" />
                                            <Border MinHeight="180"
                                                    Background="#0B1116">
                                                <Image Source="{Binding SideBySidePath, Converter={StaticResource PathToImageSource}}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        MinHeight="120"
                                                        Background="#0B1116">
                                                    <Image Source="{Binding OverlayPath, Converter={StaticResource PathToImageSource}}"
                                                           Stretch="Uniform" />
                                                </Border>
                                                <Border Grid.Column="2"
                                                        MinHeight="120"
                                                        Background="#0B1116">
                                                    <Image Source="{Binding HeatmapPath, Converter={StaticResource PathToImageSource}}"
                                                           Stretch="Uniform" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding EvidencePath, StringFormat=Evidence: {0}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Margin="0,10,0,0"
                              Header="Resolved assets and providers">
                        <ItemsControl Margin="0,6,0,0"
                                      ItemsSource="{Binding ResolvedPreviewAssets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <ItemsControl Margin="0,8,0,0"
                                  ItemsSource="{Binding PreviewWarnings}"
                                  automation:AutomationProperties.Name="High fidelity preview warnings">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,4"
                                           Foreground="#E0B46A"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="4"
                    Style="{StaticResource CardBorder}"
                    automation:AutomationProperties.Name="Main workspace selected details">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              automation:AutomationProperties.Name="Main workspace details viewport">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="EXACT SELECTION" />
                        <TextBlock Margin="0,5,0,8"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedIdentityText}" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding SelectedProviderText}" />
                        <TextBlock Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedDetailText}" />
                        <TextBlock Margin="0,6,0,12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedStateText}" />

                        <UniformGrid Columns="2">
                            <Button Margin="0,0,6,6"
                                    Command="{Binding MarkChangedCommand}"
                                    Content="Mark _changed"
                                    automation:AutomationProperties.Name="Mark selected changed" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding ResetCommand}"
                                    Content="_Reset"
                                    automation:AutomationProperties.Name="Reset selected drafts" />
                            <Button Margin="0,0,6,6"
                                    Command="{Binding MarkDeleteCommand}"
                                    Content="Mark _delete"
                                    automation:AutomationProperties.Name="Mark selected for deletion" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding RestoreCommand}"
                                    Content="Res_tore"
                                    automation:AutomationProperties.Name="Restore selected deletion" />
                        </UniformGrid>

                        <TextBlock Margin="0,8,0,4"
                                   FontWeight="SemiBold"
                                   Text="PlaceAtMe (XX remains unresolved)" />
                        <TextBox IsReadOnly="True"
                                 Text="{Binding PlaceAtMeText, Mode=OneWay}"
                                 automation:AutomationProperties.Name="Selected NPC placeatme text" />
                        <Button Margin="0,6,0,10"
                                Command="{Binding CopyPlaceAtMeCommand}"
                                Content="_Prepare placeatme text"
                                automation:AutomationProperties.Name="Copy selected NPC placeatme text" />

                        <TextBlock Margin="0,4,0,8"
                                   FontWeight="SemiBold"
                                   Text="Production tasks" />
                        <UniformGrid Columns="2">
                            <Button Margin="0,0,6,6"
                                    Command="{Binding EditNpcCommand}"
                                    Content="Edit _NPC" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding EditHeadPartsCommand}"
                                    Content="Head _parts" />
                            <Button Margin="0,0,6,6"
                                    Command="{Binding EditFaceCommand}"
                                    Content="Edit _face"
                                    automation:AutomationProperties.Name="Edit selected NPC face" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding EditBodyCommand}"
                                    Content="Edit _body" />
                            <Button Margin="0,0,6,6"
                                    Command="{Binding EditOutfitCommand}"
                                    Content="Edit _outfit" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding LoadRaceMenuPresetCommand}"
                                    Content="_Load preset" />
                            <Button Margin="0,0,6,6"
                                    Command="{Binding SaveRaceMenuPresetCommand}"
                                    Content="Save p_reset" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding CopyAppearanceCommand}"
                                    Content="_Copy look" />
                            <Button Margin="0,0,6,6"
                                    Command="{Binding PasteAppearanceCommand}"
                                    Content="_Paste look" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding CharGenOptionsCommand}"
                                    Content="CharGen _options" />
                            <Button Margin="0,0,6,6"
                                    Command="{Binding BuildCharGenCommand}"
                                    Content="_Build CharGen" />
                            <Button Margin="0,0,0,6"
                                    Command="{Binding SavePackageCommand}"
                                    Content="Save _package"
                                    automation:AutomationProperties.Name="Save selected package" />
                            <Button Margin="0,0,6,6"
                                    Click="OpenDualToneHairWizard"
                                    Content="_Dual-tone hair..."
                                    automation:AutomationProperties.Name="Dual-tone Hair / Accent Regions" />
                        </UniformGrid>
                        <Button Margin="0,2,0,8"
                                Command="{Binding ExportSceneNifCommand}"
                                Content="Export scene _NIF"
                                automation:AutomationProperties.Name="Export accepted preview scene NIF" />
                        <TextBlock Margin="0,0,0,10"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="{Binding SaveRaceMenuAvailabilityText}" />

                        <TextBlock Margin="0,4,0,6"
                                   FontWeight="SemiBold"
                                   Text="Verified child artifacts" />
                        <ItemsControl ItemsSource="{Binding Artifacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,7">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Kind}" />
                                        <TextBlock FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Path.Value}" />
                                        <TextBlock FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Sha256.Value}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,4"
                                   FontWeight="SemiBold"
                                   Text="Status and diagnostics" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding Status}" />
                        <ItemsControl Margin="0,6,0,0"
                                      ItemsSource="{Binding Diagnostics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
    </Grid>
</UserControl>
