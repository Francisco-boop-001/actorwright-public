<UserControl x:Class="NpcManager.Desktop.NativeFaceGenBatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Native FaceGen batch workspace">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,16,10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="570" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" MinWidth="310" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" IsEnabled="{Binding IsNotBusy}">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        Background="#13252C" BorderBrush="#2F665E">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="COPIED DATA  /  STATIC FACEGEN" />
                        <TextBlock Margin="0,6,0,0" FontSize="23" FontWeight="SemiBold"
                                   Text="Bake canonical FaceGen for winning NPCs" />
                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Reads an explicit copied Skyrim load order, then creates one atomic FaceGeom NIF and FaceTint DDS pair per admitted NPC. The live game is never touched." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="1  SOURCE" />
                        <TextBlock Margin="0,5,0,16" FontSize="19" FontWeight="SemiBold"
                                   Text="Copied Skyrim Data folder" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DataRoot, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Copied Skyrim Data folder" />
                            <Button Grid.Column="1" Margin="10,0,0,0"
                                    Style="{StaticResource QuietButton}" Content="Choose"
                                    Command="{Binding BrowseDataRootCommand}"
                                    automation:AutomationProperties.Name="Choose copied Skyrim Data folder" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="2  LOAD ORDER" />
                        <TextBlock Margin="0,5,0,5" FontSize="19" FontWeight="SemiBold"
                                   Text="Explicit ascending plugin order" />
                        <TextBlock Margin="0,0,0,12" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Enter one plugin per line, or separate names with commas. The last provider wins." />
                        <TextBox MinHeight="112" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding PluginOrderText, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Ascending plugin load order" />
                        <TextBlock Margin="0,14,0,5" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Optional winning-plugin filter" />
                        <TextBox Text="{Binding WinningPlugin, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Winning plugin filter" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="3  OUTPUT" />
                        <TextBlock Margin="0,5,0,16" FontSize="19" FontWeight="SemiBold"
                                   Text="Empty K-local output Data folder" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="FaceGen output Data folder" />
                            <Button Grid.Column="1" Margin="10,0,0,0"
                                    Style="{StaticResource QuietButton}" Content="Choose"
                                    Command="{Binding BrowseOutputRootCommand}"
                                    automation:AutomationProperties.Name="Choose FaceGen output Data folder" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        Background="#111E2B">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="BAKE" />
                        <TextBlock Margin="0,5,0,4" FontSize="21" FontWeight="SemiBold"
                                   Text="Generate verified pairs" />
                        <TextBlock Margin="0,0,0,18" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Discovery, NIF generation, DDS composition, promotion, and readback use the same service as facegen bake-all-native in the CLI." />
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Bake FaceGen for copied NPCs"
                                IsEnabled="{Binding CanStart}"
                                Click="StartBatchClick"
                                automation:AutomationProperties.Name="Bake native FaceGen batch" />
                        <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding Status}" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="LAST RESULT" />
                        <TextBlock Margin="0,5,0,14" FontSize="19" FontWeight="SemiBold"
                                   Text="{Binding Verdict}" />
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Discovered" />
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Discovered}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,10">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Baked" />
                                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding Baked}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Skipped" />
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Skipped}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Failed" />
                                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="{Binding Failed}" />
                            </StackPanel>
                        </UniformGrid>
                        <Border Padding="10" Background="{DynamicResource AccentDarkBrush}" CornerRadius="7">
                            <TextBlock Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding RuntimeAuthority}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="SAFETY" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Complete existing pairs are preserved as unclaimed skips. A half-pair, ambiguous provider, stale hash, unsafe path, malformed record, or failed readback blocks that NPC or the batch visibly." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
