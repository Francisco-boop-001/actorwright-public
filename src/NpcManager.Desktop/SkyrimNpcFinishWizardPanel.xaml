<UserControl x:Class="NpcManager.Desktop.SkyrimNpcFinishWizardPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             MinWidth="700">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Finish NPC — Core" />
            <TextBlock Margin="0,6,0,14" TextWrapping="Wrap"
                       Text="Four steps: Source, Role and Outfit, Routine, and Finish Core Review. Placement is not included in this workflow." />
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,0" Padding="10,6" BorderThickness="1"
                                BorderBrush="{DynamicResource AccentStrongBrush}">
                            <TextBlock Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Margin="0,16,0,0" Padding="12" BorderThickness="1"
                    BorderBrush="{DynamicResource AccentStrongBrush}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Finish Core review boundary" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="No CELL, WRLD, ACHR, REFR, placement anchor, or hidden transform is accepted. Static completion is runtime-required." />
                    <TextBlock Margin="0,10,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="0,12,0,0" Padding="12" BorderThickness="1"
                    BorderBrush="{DynamicResource AccentStrongBrush}"
                    automation:AutomationProperties.Name="External hair dependency state">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="External hair dependency" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Provider" />
                    <TextBlock Text="{Binding ExternalProviderNameDisplay}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair provider" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Expected plugin hash" />
                    <TextBlock Text="{Binding ExternalProviderExpectedHash}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair expected plugin hash" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Current plugin hash" />
                    <TextBlock Text="{Binding ExternalProviderCurrentHash}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair current plugin hash" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Enabled state" />
                    <TextBlock Text="{Binding ExternalProviderEnabledState}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair provider enabled state" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Descriptor ID" />
                    <TextBlock Text="{Binding ExternalDescriptorIdDisplay}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair descriptor ID" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Missing portable items" />
                    <TextBlock Text="{Binding ExternalMissingPortableItemsText}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair missing portable items" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Drifted portable items" />
                    <TextBlock Text="{Binding ExternalDriftedPortableItemsText}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair drifted portable items" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Install dependency state" />
                    <TextBlock Text="{Binding ExternalInstallDependencyState}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair install dependency state" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Install ready" />
                    <TextBlock Text="{Binding ExternalInstallReady}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair install ready" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Next gate" />
                    <TextBlock Text="{Binding ExternalNextGate}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair next gate" />
                    <TextBlock Margin="0,6,0,0"
                               Text="Historical snapshot" />
                    <TextBlock Text="{Binding ExternalHistoricalSnapshot}"
                               TextWrapping="Wrap"
                               automation:AutomationProperties.Name="External hair historical snapshot" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
