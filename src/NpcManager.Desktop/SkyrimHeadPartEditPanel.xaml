<UserControl x:Class="NpcManager.Desktop.SkyrimHeadPartEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Edit Skyrim NPC head parts task">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,16,10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="590" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="2*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        Background="#13252C" BorderBrush="#2F665E">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="HEAD PARTS  /  REVIEWED PNAM" />
                        <TextBlock Margin="0,5,0,7" FontSize="23" FontWeight="SemiBold"
                                   Text="Choose one compatible Skyrim head part" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Load one NPC from the reviewed copied workspace, inspect its exact ordered PNAM rows, then use the typed race/sex-compatible catalog. Nothing is written until review." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="1  LOAD EXACT NPC" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource MutedTextBrush}" Text="Reviewed source plugin" />
                                <TextBox Text="{Binding SourcePlugin, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Head-part source plugin" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,5" Foreground="{DynamicResource MutedTextBrush}" Text="NPC FormID" />
                                <TextBox Text="{Binding NpcFormId, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Head-part NPC FormID" />
                            </StackPanel>
                        </Grid>
                        <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource QuietButton}" Content="_Load PNAM and catalogs"
                                Command="{Binding LoadCommand}"
                                automation:AutomationProperties.Name="Load exact NPC head parts" />
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding Context}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="2  STAGE ONE TYPED SELECTION" />
                        <ListView Margin="0,10,0,12" MinHeight="210"
                                  ItemsSource="{Binding HeadParts}"
                                  Background="#0E1924" BorderBrush="#294052"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  automation:AutomationProperties.Name="Ordered staged NPC head parts">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="#13252C" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="BorderBrush" Value="#294052" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Type" Width="150" DisplayMemberBinding="{Binding Type}" />
                                    <GridViewColumn Header="Plugin" Width="245" DisplayMemberBinding="{Binding Plugin}" />
                                    <GridViewColumn Header="FormID" Width="130" DisplayMemberBinding="{Binding FormId}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Grid IsEnabled="{Binding IsLoaded}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding TypeOptions}"
                                      SelectedItem="{Binding SelectedType}"
                                      DisplayMemberPath="Label"
                                      automation:AutomationProperties.Name="Head-part type to replace" />
                            <Button Grid.Column="1" Margin="10,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="_Choose compatible head part..."
                                    IsEnabled="{Binding CanOpenPicker}"
                                    Click="ChooseHeadPart_Click"
                                    automation:AutomationProperties.Name="Open compatible head-part picker" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="3  REVIEW EXACT CHANGE" />
                        <ListView Margin="0,10,0,0" MinHeight="100"
                                  ItemsSource="{Binding Changes}"
                                  Background="#0E1924" BorderBrush="#294052"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  automation:AutomationProperties.Name="Reviewed head-part changes">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="#13252C" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="BorderBrush" Value="#294052" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Field" Width="120" DisplayMemberBinding="{Binding Field}" />
                                    <GridViewColumn Header="Before" Width="255" DisplayMemberBinding="{Binding Before}" />
                                    <GridViewColumn Header="After" Width="255" DisplayMemberBinding="{Binding After}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel IsEnabled="{Binding IsNotBusy}">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="OUTPUT" />
                        <TextBlock Margin="0,5,0,12" FontSize="19" FontWeight="SemiBold"
                                   Text="Fresh same-name plugin" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="New plugin path" />
                        <TextBox Margin="0,5,0,0"
                                 Text="{Binding OutputPlugin, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Head-part output plugin path" />
                        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding ReadinessText}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="REVIEW AND WRITE" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}"
                                Content="_Review PNAM change" Command="{Binding ReviewCommand}"
                                automation:AutomationProperties.Name="Review exact head-part change" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}"
                                Content="_Write and reopen plugin" Command="{Binding ExecuteCommand}"
                                automation:AutomationProperties.Name="Write verified head-part plugin" />
                        <Button Margin="0,10,0,0" Style="{StaticResource QuietButton}"
                                Content="_Cancel operation" Command="{Binding CancelCommand}"
                                automation:AutomationProperties.Name="Cancel head-part operation" />
                        <ProgressBar Margin="0,18,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     automation:AutomationProperties.Name="Head-part edit progress" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="RESULT" />
                        <TextBlock Margin="0,5,0,12" FontSize="19" FontWeight="SemiBold"
                                   Text="{Binding Verdict}" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Plugin" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ResultPlugin}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="SHA-256" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding ResultPluginSha256}" TextWrapping="Wrap" />
                        <Border Margin="0,14,0,0" Padding="10" Background="{DynamicResource AccentDarkBrush}" CornerRadius="7">
                            <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                       Text="The picker preview is off-engine geometry evidence. Static PNAM readback does not prove Skyrim rendering, hair physics, tint, or runtime behavior." />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="DIAGNOSTICS" />
                        <ListBox Margin="0,10,0,0" MaxHeight="200"
                                 ItemsSource="{Binding Diagnostics}"
                                 automation:AutomationProperties.Name="Head-part edit diagnostics" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
