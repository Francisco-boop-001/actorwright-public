<Window x:Class="NpcManager.Desktop.SkyrimArmorAddonReferenceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Armor addon (ARMA)"
        Width="680" Height="650" MinWidth="560" MinHeight="520"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}"
        automation:AutomationProperties.Name="Skyrim Armor-addon reference editor">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource EyebrowText}" Text="SKYRIM ARMA REFERENCE" />
            <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"
                       Text="Choose an armor addon" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                       Text="Only reviewed ARMA records compatible with the owning armor race can be returned."
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="OWNING ARMOR RACE" />
                        <TextBlock Margin="0,5,0,0" FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding OwningRaceText}" TextWrapping="Wrap"
                                   automation:AutomationProperties.Name="Qualified owning armor race" />
                        <Separator Margin="0,14,0,12" />
                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                   Text="{Binding CurrentName}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding CurrentReference}" TextWrapping="Wrap"
                                   automation:AutomationProperties.Name="Current qualified ARMA reference" />
                        <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding CompatibilitySummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource CardBorder}" Padding="16">
                    <StackPanel>
                        <Label Padding="0" FontWeight="SemiBold" Content="_Search compatible ARMA"
                               Target="{Binding ElementName=SearchBox}" />
                        <TextBox x:Name="SearchBox" Margin="0,7,0,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Search compatible Armor Addons" />
                        <TextBlock Margin="0,7,0,0" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding CatalogSummary}" TextWrapping="Wrap"
                                   automation:AutomationProperties.Name="{Binding CatalogSummary}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding EmptyMessage}" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Polite" />
                        <ListBox Margin="0,10,0,0" MaxHeight="190"
                                 ItemsSource="{Binding Candidates}"
                                 SelectedItem="{Binding SelectedCandidate}"
                                 automation:AutomationProperties.Name="Compatible Armor Addons">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="automation:AutomationProperties.Name"
                                            Value="{Binding AutomationName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,5">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding ReferenceText}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding CompatibilityText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Margin="0,10,0,0" HorizontalAlignment="Left" MinWidth="150"
                                Style="{StaticResource QuietButton}" Content="_Choose selected"
                                IsEnabled="{Binding CanChoose}" Click="Choose_OnClick"
                                automation:AutomationProperties.Name="Choose selected compatible ARMA" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Padding="12" CornerRadius="8"
                        Background="#171D24" BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1">
                    <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding AuthorityNotice}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Margin="2,10,2,0" Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Margin="2,6,2,0" Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="105" Style="{StaticResource QuietButton}" Content="_Cancel"
                    IsCancel="True" Click="Cancel_OnClick"
                    automation:AutomationProperties.Name="Cancel Armor-addon reference edit" />
            <Button MinWidth="125" Margin="10,0,0,0" Style="{StaticResource QuietButton}"
                    Content="_Edit ARMA..." IsEnabled="{Binding CanEdit}"
                    Click="Edit_OnClick"
                    automation:AutomationProperties.Name="Deep edit selected Armor Addon" />
            <Button MinWidth="135" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Content="_Use ARMA"
                    IsDefault="True" IsEnabled="{Binding CanUse}" Click="Use_OnClick"
                    automation:AutomationProperties.Name="Use selected Armor Addon" />
        </StackPanel>
    </Grid>
</Window>
