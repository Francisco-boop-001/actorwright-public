<Window x:Class="NpcManager.Desktop.SkyrimOutfitEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Choose or author a Skyrim outfit"
        Width="1240" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=OutfitFilterBox}"
        automation:AutomationProperties.Name="Browse or author a Skyrim NPC outfit">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Style="{StaticResource EyebrowText}"
                       Text="SKYRIM OUTFIT WORKBENCH" />
            <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"
                       Text="Choose an outfit or build one safely" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Browse winning OTFT records, or author an ordered ARMO/LVLI transaction. Preview conflicts never remove saved entries." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14,11"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding ModeTitle}" />
                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding ModeDescription}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding DraftSummary}"
                           automation:AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" MinWidth="600" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" x:Name="EditorTabs"
                        automation:AutomationProperties.Name="Outfit browser and authoring tabs">
                <TabItem Header="_Browse">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center"
                                       Text="_Filter" />
                            <TextBox x:Name="OutfitFilterBox" Grid.Column="1" MinHeight="34"
                                     Padding="9,6" Text="{Binding OutfitFilter, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Filter outfits by name, plugin, FormID, or item" />
                        </Grid>
                        <ListBox Grid.Row="1" Margin="0,12,0,12"
                                 ItemsSource="{Binding BrowseRows}"
                                 SelectedItem="{Binding SelectedBrowseRow}"
                                 automation:AutomationProperties.Name="Outfit choices">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="7,5">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button MinWidth="150" Style="{StaticResource PrimaryButton}"
                                    Content="_Use selected" Click="Accept_OnClick"
                                    automation:AutomationProperties.Name="Use selected outfit choice" />
                            <Button MinWidth="130" Margin="9,0,0,0"
                                    Style="{StaticResource QuietButton}"
                                    Content="_New outfit" Click="BeginNew_OnClick"
                                    automation:AutomationProperties.Name="Begin a new outfit" />
                            <Button MinWidth="170" Margin="9,0,0,0"
                                    Style="{StaticResource QuietButton}"
                                    Content="_Override selected" Click="BeginOverride_OnClick"
                                    automation:AutomationProperties.Name="Override the selected existing outfit" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="_Author">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="New _EditorID" />
                            <TextBox Grid.Column="1" Margin="9,0,0,0" MinHeight="33" Padding="8,5"
                                     Text="{Binding NewEditorId, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="New outfit EditorID" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Item _filter" />
                            <TextBox Grid.Column="4" Margin="9,0,0,0" MinHeight="33" Padding="8,5"
                                     Text="{Binding ItemFilter, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Filter armor and leveled-list items" />
                        </Grid>

                        <ListBox Grid.Row="1" Margin="0,10,0,8"
                                 ItemsSource="{Binding AvailableItems}"
                                 SelectedItem="{Binding SelectedAvailableItem}"
                                 automation:AutomationProperties.Name="Available ARMO and LVLI items">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="7,4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                            <Button MinWidth="125" Style="{StaticResource QuietButton}"
                                    Content="_Add item" Click="AddItem_OnClick"
                                    automation:AutomationProperties.Name="Add selected item to outfit" />
                            <Button MinWidth="130" Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                                    Content="Begin _new" Click="BeginNew_OnClick" />
                            <Button MinWidth="150" Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                                    Content="Begin _override" Click="BeginOverride_OnClick" />
                            <Button MinWidth="115" Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                                    Content="New _ARMO" Click="NewArmor_OnClick"
                                    automation:AutomationProperties.Name="Open the typed new armor child editor" />
                            <Button MinWidth="110" Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                                    Content="New _LVLI" Click="NewLeveledList_OnClick"
                                    automation:AutomationProperties.Name="Open the typed new leveled-list child editor" />
                        </WrapPanel>

                        <DataGrid Grid.Row="3" Margin="0,0,0,8" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  ItemsSource="{Binding DraftItems}"
                                  SelectedItem="{Binding SelectedDraftItem}"
                                  automation:AutomationProperties.Name="Authored outfit equip order">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding EquipOrder}" Width="42" />
                                <DataGridTextColumn Header="Piece" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Signature}" Width="58" />
                                <DataGridTextColumn Header="Qualified reference" Binding="{Binding QualifiedReference}" Width="2*" />
                                <DataGridTextColumn Header="Slots" Binding="{Binding SlotMask}" Width="100" />
                                <DataGridTextColumn Header="Preview" Binding="{Binding PreviewStatus}" Width="2*" />
                                <DataGridTextColumn Header="Realization" Binding="{Binding Realization}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="4">
                            <Button Width="42" Style="{StaticResource QuietButton}" Content="_▲"
                                    Click="MoveUp_OnClick" automation:AutomationProperties.Name="Move outfit item earlier" />
                            <Button Width="42" Margin="6,0,0,0" Style="{StaticResource QuietButton}" Content="_▼"
                                    Click="MoveDown_OnClick" automation:AutomationProperties.Name="Move outfit item later" />
                            <Button MinWidth="105" Margin="6,0,0,0" Style="{StaticResource QuietButton}"
                                    Content="_Remove" Click="RemoveItem_OnClick" />
                            <Button MinWidth="105" Margin="6,0,0,0" Style="{StaticResource QuietButton}"
                                    Content="_Edit item" Click="EditItem_OnClick"
                                    automation:AutomationProperties.Name="Edit the selected ARMO or LVLI inside the transaction" />
                            <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="Reroll _seed" />
                            <TextBox Width="120" Margin="8,0,0,0" MinHeight="32" Padding="8,5"
                                     Text="{Binding RerollSeed, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Deterministic leveled-list reroll seed" />
                            <Button MinWidth="110" Margin="7,0,0,0" Style="{StaticResource QuietButton}"
                                    Content="_Reroll LVLI" Click="Reroll_OnClick" />
                            <Button MinWidth="110" Margin="7,0,0,0" Style="{StaticResource QuietButton}"
                                    Content="Rese_t" Click="Reset_OnClick"
                                    automation:AutomationProperties.Name="Reset the whole authoring transaction" />
                        </WrapPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="PREVIEW PLAN" />
                        <TextBlock Margin="0,4,0,0" FontSize="20" FontWeight="SemiBold"
                                   Text="What the renderer should receive" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,14,0,12" Orientation="Horizontal">
                        <RadioButton GroupName="PreviewMode" Content="Whole _outfit"
                                     IsChecked="True" Checked="WholePreview_OnChecked" />
                        <RadioButton GroupName="PreviewMode" Margin="16,0,0,0"
                                     Content="Selected _piece only"
                                     IsChecked="{Binding PreviewSelectedPiece}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 Text="{Binding PreviewSummary, Mode=OneWay}" TextWrapping="Wrap"
                                 automation:AutomationProperties.Name="Qualified preview item plan" />
                    </ScrollViewer>
                    <Border Grid.Row="3" Margin="0,14,0,0" Padding="12" CornerRadius="8"
                            Background="#171D24" BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1">
                        <TextBlock FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding AuthorityNotice}" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="110" Style="{StaticResource QuietButton}"
                        Content="_Cancel" IsCancel="True" Click="Cancel_OnClick"
                        automation:AutomationProperties.Name="Cancel the whole outfit transaction" />
                <Button MinWidth="150" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="_Use or save" IsDefault="True" Click="Accept_OnClick"
                        automation:AutomationProperties.Name="Use the selected outfit or save the authored proposal" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
