<Window x:Class="NpcManager.Desktop.SkyrimArmorEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Skyrim Armor editor"
        Width="1120" Height="820" MinWidth="860" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=ArmorNameBox}"
        automation:AutomationProperties.Name="Edit one Skyrim armor record">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowText}" Text="SKYRIM OUTFIT AUTHORING" />
                <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"
                           Text="Armor editor" />
                <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Identity.IntentLabel}" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding Identity.TargetIdentity}" />
                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Right"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Identity.SourceIdentity, StringFormat=Source: {0}}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,14" Style="{StaticResource CardBorder}" Padding="12">
            <WrapPanel>
                <Button Style="{StaticResource QuietButton}" Content="New _blank"
                        Click="Blank_OnClick"
                        automation:AutomationProperties.Name="Start a blank new armor" />
                <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                        Content="New from _template" Click="Template_OnClick"
                        automation:AutomationProperties.Name="Copy an existing armor into a new record" />
                <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                        Content="_Override existing" Click="Override_OnClick"
                        automation:AutomationProperties.Name="Override an existing armor" />
                <Button Margin="8,0,0,0" Style="{StaticResource QuietButton}"
                        Content="Edit _mine" Click="EditAuthored_OnClick"
                        automation:AutomationProperties.Name="Continue editing an authored armor" />
                <Button Margin="24,0,0,0" Style="{StaticResource QuietButton}"
                        Content="Delete / _revert" Click="Delete_OnClick"
                        automation:AutomationProperties.Name="Delete a new authored armor or revert an override" />
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="_Core">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource CardBorder}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Padding="0" FontWeight="SemiBold" Content="_EditorID"
                                           Target="{Binding ElementName=EditorIdBox}" />
                                    <TextBox x:Name="EditorIdBox" Margin="0,6,0,0"
                                             IsEnabled="{Binding Identity.CanEditEditorId}"
                                             Text="{Binding Identity.EditorIdText, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Armor EditorID" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Padding="0" FontWeight="SemiBold" Content="Display _name"
                                           Target="{Binding ElementName=ArmorNameBox}" />
                                    <TextBox x:Name="ArmorNameBox" Margin="0,6,0,0"
                                             Text="{Binding Core.Name, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Armor display name" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorder}" Padding="18">
                            <StackPanel>
                                <CheckBox Content="_Non-playable"
                                          IsChecked="{Binding Core.NonPlayable}"
                                          automation:AutomationProperties.Name="Non-playable armor header flag" />
                                <Label Margin="0,12,0,0" Padding="0" FontWeight="SemiBold"
                                       Content="_Description" Target="{Binding ElementName=DescriptionBox}" />
                                <TextBox x:Name="DescriptionBox" Margin="0,6,0,0" Height="78"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Core.Description, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Armor description" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorder}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Padding="0" Content="_Value" Target="{Binding ElementName=ValueBox}" />
                                    <TextBox x:Name="ValueBox" Text="{Binding Core.ValueText, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Unsigned armor value" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Padding="0" Content="_Weight" Target="{Binding ElementName=WeightBox}" />
                                    <TextBox x:Name="WeightBox" Text="{Binding Core.WeightText, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Armor weight" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <Label Padding="0" Content="Armor _rating" Target="{Binding ElementName=RatingBox}" />
                                    <TextBox x:Name="RatingBox" Text="{Binding Core.ArmorRatingText, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Skyrim armor rating" />
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <Label Padding="0" Content="_BOD2 mask" Target="{Binding ElementName=SlotMaskBox}" />
                                    <TextBox x:Name="SlotMaskBox" FontFamily="Cascadia Mono, Consolas"
                                             Text="{Binding Core.SlotMaskText, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="BOD2 slot bit mask" />
                                    <Button Margin="0,8,0,0" Style="{StaticResource QuietButton}"
                                            Content="_Recalculate" Click="Recalculate_OnClick"
                                            automation:AutomationProperties.Name="Recalculate BOD2 from all armor addons" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorder}" Padding="18">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Object bounds (signed 16-bit)" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Margin="0,4,12,0" Text="Minimum" />
                                    <TextBox Grid.Column="1" Text="{Binding Bounds.MinimumX, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Minimum X bound" />
                                    <TextBox Grid.Column="3" Text="{Binding Bounds.MinimumY, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Minimum Y bound" />
                                    <TextBox Grid.Column="5" Text="{Binding Bounds.MinimumZ, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Minimum Z bound" />
                                    <TextBlock Grid.Row="2" Margin="0,4,12,0" Text="Maximum" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Bounds.MaximumX, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Maximum X bound" />
                                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Bounds.MaximumY, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Maximum Y bound" />
                                    <TextBox Grid.Row="2" Grid.Column="5" Text="{Binding Bounds.MaximumZ, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Maximum Z bound" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_References &amp; models">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <Border Style="{StaticResource CardBorder}" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <Label Padding="0" Content="_Race (required)" />
                                    <TextBox Text="{Binding References.Race, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Qualified race reference" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Padding="0" Content="_Enchantment" />
                                    <TextBox Text="{Binding References.Enchantment, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Qualified enchantment reference" />
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <Label Padding="0" Content="_Pickup sound" />
                                    <TextBox Text="{Binding References.PickupSound, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Qualified pickup sound reference" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <Label Padding="0" Content="_Drop sound" />
                                    <TextBox Text="{Binding References.DropSound, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Qualified drop sound reference" />
                                </StackPanel>
                                <StackPanel Grid.Row="4">
                                    <Label Padding="0" Content="E_quipment type" />
                                    <TextBox Text="{Binding References.EquipmentType, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Qualified equipment type reference" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2">
                                    <Label Padding="0" Content="_Block material" />
                                    <TextBox Text="{Binding References.AlternateBlockMaterial, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Qualified alternate block material reference" />
                                </StackPanel>
                                <StackPanel Grid.Row="6">
                                    <Label Padding="0" Content="Preserved template ARMO" />
                                    <TextBox Text="{Binding References.TemplateArmor, UpdateSourceTrigger=PropertyChanged}"
                                             automation:AutomationProperties.Name="Qualified template armor reference" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Margin="0,14,0,0" Style="{StaticResource CardBorder}" Padding="18">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="World models" />
                                <TextBlock Margin="0,4,0,10" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Safe .nif paths relative to Meshes. Empty clears that gender's model; static acceptance does not prove the mesh exists or renders." TextWrapping="Wrap" />
                                <Label Padding="0" Content="_Male model" />
                                <TextBox Text="{Binding References.MaleWorldModel, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Male world model path relative to Meshes" />
                                <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Content="Browse _male world model..."
                                        Click="PickMaleWorldModel_OnClick"
                                        automation:AutomationProperties.Name="Browse male world model" />
                                <Label Margin="0,10,0,0" Padding="0" Content="_Female model" />
                                <TextBox Text="{Binding References.FemaleWorldModel, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Female world model path relative to Meshes" />
                                <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Content="Browse _female world model..."
                                        Click="PickFemaleWorldModel_OnClick"
                                        automation:AutomationProperties.Name="Browse female world model" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_Armor addons &amp; keywords">
                <ScrollViewer x:Name="CollectionsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Padding="0" Content="Qualified _Plugin|FormID" />
                                <TextBox Text="{Binding Collections.CandidateReference, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Candidate qualified armor-addon or keyword reference" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="18,23,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="ARMA order is serialized; KWDA values are unique." />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Ordered ARMA references" />
                                <ListBox Grid.Row="1" Margin="0,10,0,10" MinHeight="96"
                                         ItemsSource="{Binding Collections.ArmorAddons}"
                                         SelectedIndex="{Binding Collections.SelectedArmorAddonIndex}"
                                         automation:AutomationProperties.Name="Ordered armor addon references" />
                                <WrapPanel Grid.Row="2">
                                    <Button Style="{StaticResource QuietButton}" Content="_Add" Click="AddAddon_OnClick"
                                            automation:AutomationProperties.Name="Add armor addon reference" />
                                    <Button Margin="6,0,0,0" Style="{StaticResource QuietButton}" Content="_Replace" Click="ReplaceAddon_OnClick"
                                            automation:AutomationProperties.Name="Replace selected armor addon reference" />
                                    <Button Margin="6,0,0,0" Style="{StaticResource QuietButton}" Content="Remove" Click="RemoveAddon_OnClick"
                                            automation:AutomationProperties.Name="Remove selected armor addon reference" />
                                    <Button Margin="14,0,0,0" Style="{StaticResource QuietButton}" Content="Move up" Click="MoveAddonUp_OnClick"
                                            automation:AutomationProperties.Name="Move selected armor addon up" />
                                    <Button Margin="6,0,0,0" Style="{StaticResource QuietButton}" Content="Move down" Click="MoveAddonDown_OnClick"
                                            automation:AutomationProperties.Name="Move selected armor addon down" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Unique KWDA references" />
                                <ListBox Grid.Row="1" Margin="0,10,0,10" MinHeight="96"
                                         ItemsSource="{Binding Collections.Keywords}"
                                         SelectedIndex="{Binding Collections.SelectedKeywordIndex}"
                                         automation:AutomationProperties.Name="Armor keyword references" />
                                <WrapPanel Grid.Row="2">
                                    <Button Style="{StaticResource QuietButton}" Content="Add _keyword" Click="AddKeyword_OnClick"
                                            automation:AutomationProperties.Name="Add armor keyword reference" />
                                    <Button Margin="6,0,0,0" Style="{StaticResource QuietButton}" Content="Remove" Click="RemoveKeyword_OnClick"
                                            automation:AutomationProperties.Name="Remove selected armor keyword reference" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="_Preview boundary">
                <StackPanel Margin="16">
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Advisory preview request" />
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                       Text="By default the request contains only this armor." />
                            <CheckBox Margin="0,10,0,0" Content="Preview the _full outfit"
                                      IsChecked="{Binding PreviewFullOutfit}" />
                            <CheckBox Margin="0,10,0,0" Content="Include _body"
                                      IsChecked="{Binding IncludeBody}" />
                            <CheckBox Margin="0,10,0,0" Content="Show _other gender"
                                      IsChecked="{Binding AlternateGender}" />
                            <Button Margin="0,16,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButton}" Content="Request _preview"
                                    Click="Preview_OnClick"
                                    automation:AutomationProperties.Name="Request advisory armor preview" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <TextBlock Foreground="{DynamicResource WarningBrush}" Text="{Binding AuthorityNotice}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           automation:AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button MinWidth="110" Style="{StaticResource QuietButton}" Content="_Cancel"
                        IsCancel="True" Click="Cancel_OnClick"
                        automation:AutomationProperties.Name="Cancel the whole armor transaction" />
                <Button MinWidth="150" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                        Content="_Save armor" IsDefault="True" IsEnabled="{Binding CanSave}"
                        Click="Save_OnClick" automation:AutomationProperties.Name="Save immutable armor document" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
