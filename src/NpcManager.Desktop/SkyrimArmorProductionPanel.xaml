<UserControl x:Class="NpcManager.Desktop.SkyrimArmorProductionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Create and verify a Skyrim armor task">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,16,10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="620" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="2*" MinWidth="350" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        Background="#13252C" BorderBrush="#2F665E">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}"
                                   Text="ARMOR AUTHORITY  /  ARMO TRANSACTION" />
                        <TextBlock Margin="0,5,0,7" FontSize="23" FontWeight="SemiBold"
                                   Text="Author, write, and reopen one armor" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Loads one explicit source-owned ARMO from the reviewed copied closure. The owner-modal editor returns one immutable complete Skyrim document; Review writes JSON only." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="1  REVIEWED SOURCE" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Source-owned plugin" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding SourcePlugin, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Armor source plugin" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Source ARMO FormID" />
                                <TextBox Margin="0,5,0,0"
                                         Text="{Binding SourceFormId, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Armor source FormID" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,12,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="New local ARMO FormID" />
                        <TextBox Text="{Binding NewTargetFormId, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="New armor local FormID" />
                        <TextBlock Margin="0,12,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="New local ARMA FormID" />
                        <TextBox Text="{Binding NewArmorAddonTargetFormId, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="New armor-addon local FormID" />
                        <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource QuietButton}"
                                Content="_Load reviewed ARMO source"
                                Command="{Binding LoadCommand}"
                                automation:AutomationProperties.Name="Load reviewed armor source" />
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="2  AUTHOR IMMUTABLE ARMO" />
                        <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}"
                                Content="_Open Armor editor"
                                IsEnabled="{Binding CanOpenEditor}"
                                Click="OpenArmorEditor_Click"
                                automation:AutomationProperties.Name="Open Skyrim armor editor" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding DocumentSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"
                        IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="FRESH BINARY OUTPUT" />
                        <TextBlock Margin="0,8,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Fresh Armor proposal JSON" />
                        <TextBox Text="{Binding ProposalPath, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Armor production proposal path" />
                        <TextBlock Margin="0,12,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Fresh output plugin" />
                        <TextBox Text="{Binding OutputPlugin, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Armor output plugin" />
                        <TextBlock Margin="0,12,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Fresh authored ARMA output plugin" />
                        <TextBox Text="{Binding ArmorAddonOutputPlugin, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Armor-addon output plugin" />
                        <TextBlock Margin="0,7,0,0" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Required only when the accepted Armor contains one authored Gate-020 child. The modal itself performs no file I/O." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="3  REVIEW, WRITE, REOPEN" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}"
                                Content="_Review ARMO proposal" Command="{Binding ReviewCommand}"
                                automation:AutomationProperties.Name="Review armor proposal" />
                        <Button Margin="0,10,0,0" Style="{StaticResource PrimaryButton}"
                                Content="_Write and verify armor" Command="{Binding ExecuteCommand}"
                                automation:AutomationProperties.Name="Write and verify armor output" />
                        <Button Margin="0,10,0,0" Style="{StaticResource QuietButton}"
                                Content="_Cancel operation" Command="{Binding CancelCommand}"
                                automation:AutomationProperties.Name="Cancel armor operation" />
                        <ProgressBar Margin="0,18,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     automation:AutomationProperties.Name="Armor transaction progress" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding Status}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="RESULT" />
                        <TextBlock Margin="0,5,0,12" FontSize="19" FontWeight="SemiBold"
                                   Text="{Binding Verdict}" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Proposal SHA-256" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ProposalSha256}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Authored ARMA proposal SHA-256" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ArmorAddonProposalSha256}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Authored ARMA output" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ArmorAddonResultPlugin}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Authored ARMA output SHA-256" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ArmorAddonResultSha256}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Output plugin" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ResultPlugin}" TextWrapping="Wrap" />
                        <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Output SHA-256" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding ResultSha256}" TextWrapping="Wrap" />
                        <Border Margin="0,14,0,0" Padding="10"
                                Background="{DynamicResource AccentDarkBrush}" CornerRadius="7">
                            <TextBlock Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                       Text="Two static ARMO readbacks are not preview, equipment, runtime, or visual proof." />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="DIAGNOSTICS" />
                        <ListBox Margin="0,10,0,0" MaxHeight="190"
                                 ItemsSource="{Binding Diagnostics}"
                                 automation:AutomationProperties.Name="Armor transaction diagnostics" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
