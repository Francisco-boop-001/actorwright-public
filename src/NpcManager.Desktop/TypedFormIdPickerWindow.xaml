<Window x:Class="NpcManager.Desktop.TypedFormIdPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{Binding Title}"
        Width="1040" Height="690" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=FilterBox}"
        automation:AutomationProperties.Name="Choose a typed record">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource EyebrowText}" Text="TYPED RECORD CATALOG" />
                <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,7,0,0" MaxWidth="760"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="{Binding Purpose}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Padding="13,7" VerticalAlignment="Center"
                    Background="{DynamicResource AccentDarkBrush}"
                    BorderBrush="{DynamicResource AccentStrongBrush}"
                    BorderThickness="1" CornerRadius="16">
                <TextBlock Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                           Text="{Binding AllowedSignatures}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" Margin="0,0,18,0"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         automation:AutomationProperties.Name="Filter typed records"
                         automation:AutomationProperties.HelpText="Filter by name, EditorID, FormID, plugin, or signature" />
                <CheckBox Grid.Column="1" Margin="0,9,0,0"
                          Content="Show all, including incompatible records"
                          IsChecked="{Binding ShowAll}"
                          Visibility="{Binding CompatibilityFilterAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                          automation:AutomationProperties.Name="Show all typed records" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" MinWidth="520" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.85*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <ListView x:Name="RecordList"
                                  ItemsSource="{Binding VisibleRows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  Background="#0F1823"
                                  BorderThickness="0"
                                  MouseDoubleClick="RecordList_OnMouseDoubleClick"
                                  PreviewKeyDown="RecordList_OnPreviewKeyDown"
                                  automation:AutomationProperties.Name="Typed record choices">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="#13252C" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="BorderBrush" Value="#294052" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#184356" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="180"
                                                    DisplayMemberBinding="{Binding DisplayName}" />
                                    <GridViewColumn Header="EditorID" Width="150"
                                                    DisplayMemberBinding="{Binding EditorId}" />
                                    <GridViewColumn Header="FormID" Width="105"
                                                    DisplayMemberBinding="{Binding FormIdText}" />
                                    <GridViewColumn Header="Plugin" Width="145"
                                                    DisplayMemberBinding="{Binding PluginText}" />
                                    <GridViewColumn Header="Type" Width="70"
                                                    DisplayMemberBinding="{Binding SignatureText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="360" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding EmptyState}"
                                   Visibility="{Binding HasNoVisibleRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   automation:AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="2,10,0,0" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding VisibleCount}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowText}" Text="SELECTION EVIDENCE" />
                    <TextBlock Margin="0,5,0,10" FontSize="23" FontWeight="SemiBold"
                               Text="{Binding SelectionTitle}" TextWrapping="Wrap" />
                    <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="{Binding SelectionReference}" TextWrapping="Wrap"
                               automation:AutomationProperties.Name="Selected typed record reference" />
                    <Border Margin="0,18,0,0" Padding="14" Background="#0E1924"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Provider and override chain" />
                            <TextBlock Margin="0,6,0,0" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding SelectionProvenance}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                               automation:AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button MinWidth="150" Style="{StaticResource QuietButton}"
                    Content="_Delete / Revert..."
                    IsEnabled="{Binding CanDeleteOrRevert}"
                    Visibility="{Binding DeleteOrRevertAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Click="DeleteOrRevert_OnClick"
                    automation:AutomationProperties.Name="Delete or Revert selected record" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button MinWidth="110" Style="{StaticResource QuietButton}" Content="_Cancel"
                        IsCancel="True" Click="Cancel_OnClick"
                        automation:AutomationProperties.Name="Cancel typed record selection" />
                <Button MinWidth="150" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="_Select record" IsDefault="True"
                        IsEnabled="{Binding CanAccept}" Click="Accept_OnClick"
                        automation:AutomationProperties.Name="Select typed record" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
