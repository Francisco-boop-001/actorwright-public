<Window x:Class="NpcManager.Desktop.NativeFaceGenBatchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Native FaceGen batch"
        Width="780" Height="650" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        automation:AutomationProperties.Name="Native FaceGen batch progress and results">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource EyebrowText}" Text="NATIVE FACEGEN BATCH" />
            <TextBlock Margin="0,5,0,4" FontSize="24" FontWeight="SemiBold"
                       Text="{Binding Verdict}" />
            <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                       Text="{Binding Status}" TextWrapping="Wrap"
                       automation:AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <ProgressBar Minimum="0" Maximum="100" Height="12"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         automation:AutomationProperties.Name="Native FaceGen batch progress" />
            <TextBlock Margin="0,17,0,0" HorizontalAlignment="Right"
                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                       Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
        </Grid>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,38,0,14">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,6,0" Padding="12">
                <StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Discovered" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding Discovered}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6,0" Padding="12">
                <StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Baked" /><TextBlock FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="{Binding Baked}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6,0" Padding="12">
                <StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Skipped" /><TextBlock FontSize="21" FontWeight="SemiBold" Text="{Binding Skipped}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Margin="6,0,0,0" Padding="12">
                <StackPanel><TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Failed" /><TextBlock FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Text="{Binding Failed}" /></StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="3" automation:AutomationProperties.Name="Native FaceGen batch evidence">
            <TabItem Header="Progress log">
                <ListBox x:Name="ProgressLog" Margin="10" ItemsSource="{Binding ProgressEvents}"
                         FontFamily="Consolas" FontSize="12"
                         automation:AutomationProperties.Name="Ordered FaceGen progress log" />
            </TabItem>
            <TabItem Header="NPC outcomes">
                <ListBox Margin="10" ItemsSource="{Binding Outcomes}"
                         FontFamily="Consolas" FontSize="12"
                         automation:AutomationProperties.Name="FaceGen NPC outcomes" />
            </TabItem>
            <TabItem Header="Diagnostics">
                <ListBox Margin="10" ItemsSource="{Binding Diagnostics}"
                         automation:AutomationProperties.Name="FaceGen batch diagnostics" />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                       Text="{Binding RuntimeAuthority}" TextWrapping="Wrap" />
            <Button x:Name="CloseActionButton" Grid.Column="1" Width="132" Margin="18,0,0,0"
                    Style="{StaticResource QuietButton}"
                    Content="{Binding CloseActionContent}"
                    IsEnabled="{Binding CanUseCloseAction}"
                    Click="CancelOrCloseClick"
                    automation:AutomationProperties.Name="{Binding CloseActionName}" />
        </Grid>
    </Grid>
</Window>
