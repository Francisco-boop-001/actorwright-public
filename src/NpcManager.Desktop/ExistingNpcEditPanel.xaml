<UserControl x:Class="NpcManager.Desktop.ExistingNpcEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             automation:AutomationProperties.Name="Edit existing NPC workspace">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,16,10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="570" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" MinWidth="310" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardBorder}"
                        Margin="0,0,0,14"
                        Padding="24"
                        Background="#17262F"
                        BorderBrush="#4C7290">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowText}" Text="EXISTING NPC  /  VERIFIED OVERRIDE" />
                            <TextBlock Margin="0,6,0,0" FontSize="25" FontWeight="SemiBold"
                                       Text="Edit identity and gameplay safely" />
                            <TextBlock Margin="0,8,28,0" MaxWidth="680" FontSize="14"
                                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="Select a copied plugin, review exact identity and nonvisual gameplay changes, then create a fresh override package through the same transaction used by the CLI." />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="14,8" VerticalAlignment="Center"
                                Background="#172D42" BorderBrush="#4C7290" BorderThickness="1" CornerRadius="18">
                            <TextBlock FontWeight="SemiBold" Foreground="#9BC9EA" Text="Nonvisual fields" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel IsEnabled="{Binding IsNotBusy}">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="1  SELECT NPC" />
                        <TextBlock Margin="0,5,0,4" FontSize="19" FontWeight="SemiBold" Text="Choose a copied Skyrim plugin" />
                        <TextBlock Margin="0,0,0,16" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="The selected bytes are bound by SHA-256. Live game folders are never offered as output." />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Copied plugin" />
                                <TextBox Text="{Binding InputPlugin, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Existing NPC source plugin" />
                            </StackPanel>
                            <Button Grid.Column="1" Margin="10,24,0,0" Style="{StaticResource QuietButton}"
                                    Content="Browse..." Command="{Binding BrowseInputCommand}"
                                    automation:AutomationProperties.Name="Browse existing NPC source plugin" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Source SHA-256" />
                                <TextBox IsReadOnly="True" Text="{Binding InputSha256}"
                                         automation:AutomationProperties.Name="Existing NPC source hash" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="NPC FormID" />
                                <TextBox Text="{Binding NpcFormId, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="Existing NPC FormID" />
                            </StackPanel>
                        </Grid>
                        <Button Margin="0,14,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource QuietButton}"
                                Content="Load NPC fields" Command="{Binding LoadNpcCommand}"
                                automation:AutomationProperties.Name="Load existing NPC fields" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel IsEnabled="{Binding IsNotBusy}">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="2  EDIT NPC" />
                        <TextBlock Margin="0,5,0,4" FontSize="19" FontWeight="SemiBold" Text="Set bounded nonvisual changes" />
                        <TextBlock Margin="0,0,0,16" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                   Text="Identity, archetype, statistics, and gameplay lists begin from the loaded NPC and commit only when you save their editor. Sex, weight, headparts, and FaceGen remain untouched." />
                        <Border Padding="14"
                                Background="#131F27" BorderBrush="#365267"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Identity and archetype" />
                                <TextBlock Margin="0,4,16,0" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="{Binding IdentitySummary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center"
                                    Style="{StaticResource QuietButton}"
                                    Content="Edit identity..." IsEnabled="{Binding CanEditIdentity}"
                                    Click="EditIdentity_Click"
                                    automation:AutomationProperties.Name="Edit existing NPC identity and archetype" />
                            </Grid>
                        </Border>
                        <Border Margin="0,18,0,0" Padding="14"
                                Background="#131F27" BorderBrush="#365267"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Complete Skyrim statistics" />
                                    <TextBlock Margin="0,4,16,0" Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{Binding StatsSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Style="{StaticResource QuietButton}"
                                        Content="Edit statistics..." IsEnabled="{Binding CanEditStats}"
                                        Click="EditStats_Click"
                                        automation:AutomationProperties.Name="Edit complete existing NPC statistics" />
                            </Grid>
                        </Border>
                        <Border Margin="0,18,0,0" Padding="14"
                                Background="#131F27" BorderBrush="#365267"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Gameplay lists" />
                                    <TextBlock Margin="0,4,16,0" Foreground="{DynamicResource MutedTextBrush}"
                                               Text="{Binding CollectionSummary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center"
                                        Style="{StaticResource QuietButton}"
                                        Content="Edit lists..." IsEnabled="{Binding CanEditCollections}"
                                        Click="EditCollections_Click"
                                        automation:AutomationProperties.Name="Edit existing NPC gameplay lists" />
                            </Grid>
                        </Border>
                        <Button Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource QuietButton}"
                                Content="Review exact changes" Command="{Binding ReviewCommand}"
                                automation:AutomationProperties.Name="Review existing NPC changes" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="3  REVIEW" />
                        <TextBlock Margin="0,5,0,4" FontSize="19" FontWeight="SemiBold" Text="Before and after" />
                        <TextBlock Margin="0,0,0,10" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Nothing is written during review." />
                        <ListView ItemsSource="{Binding Changes}" MinHeight="92"
                                  Background="#0E1924" BorderBrush="#294052"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  automation:AutomationProperties.Name="Reviewed existing NPC changes">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="#13252C" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="BorderBrush" Value="#294052" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#184356" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Field" Width="170" DisplayMemberBinding="{Binding Field}" />
                                    <GridViewColumn Header="Before" Width="185" DisplayMemberBinding="{Binding Before}" />
                                    <GridViewColumn Header="After" Width="185" DisplayMemberBinding="{Binding After}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel IsEnabled="{Binding IsNotBusy}">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="OUTPUT" />
                        <TextBlock Margin="0,5,0,14" FontSize="19" FontWeight="SemiBold" Text="Fresh verified package" />
                        <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Plugin filename" />
                        <TextBox Margin="0,0,0,12" Text="{Binding PluginName, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Existing NPC output plugin filename" />
                        <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="New output folder" />
                        <TextBox Text="{Binding OutputRoot, UpdateSourceTrigger=PropertyChanged}"
                                 automation:AutomationProperties.Name="Existing NPC output folder" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Margin="0,0,8,0" Style="{StaticResource QuietButton}" Content="Choose parent..."
                                    Command="{Binding BrowseOutputParentCommand}"
                                    automation:AutomationProperties.Name="Choose existing NPC output parent" />
                            <Button Style="{StaticResource QuietButton}" Content="New folder"
                                    Command="{Binding NewOutputCommand}"
                                    automation:AutomationProperties.Name="Choose fresh existing NPC output" />
                        </WrapPanel>
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Text="{Binding ReadinessText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="CREATE" />
                        <TextBlock Margin="0,5,0,12" FontSize="19" FontWeight="SemiBold" Text="Write, reopen, verify" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Create verified override"
                                Command="{Binding ExecuteCommand}"
                                automation:AutomationProperties.Name="Create verified existing NPC override" />
                        <Button Margin="0,8,0,0" Style="{StaticResource QuietButton}" Content="Cancel"
                                Command="{Binding CancelCommand}"
                                automation:AutomationProperties.Name="Cancel existing NPC edit" />
                        <ProgressBar Margin="0,18,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                     automation:AutomationProperties.Name="Existing NPC edit progress" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontWeight="SemiBold"
                                       Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="RESULT" />
                        <TextBlock Margin="0,5,0,12" FontSize="19" FontWeight="SemiBold" Text="{Binding Verdict}" />
                        <TextBlock FontWeight="SemiBold" Text="Plugin" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ResultPlugin}" TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold" Text="SHA-256" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ResultPluginSha256}" TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold" Text="Manifest" />
                        <TextBlock Margin="0,4,0,10" Text="{Binding ResultManifest}" TextWrapping="Wrap" />
                        <Border Padding="10" Background="#241F18" BorderBrush="#6B5732" BorderThickness="1" CornerRadius="7">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                                       Text="Static verification is not in-game authority. The package includes a bounded runtime test instruction artifact." />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="DIAGNOSTICS" />
                        <ListBox Margin="0,10,0,0" MaxHeight="150" ItemsSource="{Binding Diagnostics}"
                                 automation:AutomationProperties.Name="Existing NPC edit diagnostics">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource DangerBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="No message means no actionable finding." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
