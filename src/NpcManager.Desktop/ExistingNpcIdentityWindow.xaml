<Window x:Class="NpcManager.Desktop.ExistingNpcIdentityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Edit NPC identity and archetype"
        Width="820" Height="680" MinWidth="700" MinHeight="590"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=EditorIdBox}"
        automation:AutomationProperties.Name="Existing NPC identity and archetype editor">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource EyebrowText}" Text="IDENTITY  /  TYPED RECORDS" />
            <TextBlock Margin="0,5,0,4" FontSize="24" FontWeight="SemiBold"
                       Text="Define who this NPC is" />
            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="Names and archetype begin from the hash-bound source. Save commits one validated copy; Cancel leaves the prior edit untouched." />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Names" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="EditorID" />
                                <TextBox x:Name="EditorIdBox" Text="{Binding EditorId, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="NPC EditorID" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Full display name" />
                                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                         automation:AutomationProperties.Name="NPC full display name" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Short name (optional)" />
                            <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="NPC short name" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Archetype" />
                        <TextBlock Margin="0,5,0,14" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Text="{Binding CatalogMessage}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Race (required)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="12,9" Background="#0E1924" CornerRadius="7">
                                        <TextBlock Text="{Binding Race.Label, TargetNullValue=No race selected}"
                                                   TextTrimming="CharacterEllipsis"
                                                   automation:AutomationProperties.Name="Selected NPC race" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="96"
                                            Style="{StaticResource QuietButton}" Content="_Choose..."
                                            Click="ChooseRace_Click"
                                            automation:AutomationProperties.Name="Choose NPC race" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Class (required)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="12,9" Background="#0E1924" CornerRadius="7">
                                        <TextBlock Text="{Binding NpcClass.Label, TargetNullValue=No class selected}"
                                                   TextTrimming="CharacterEllipsis"
                                                   automation:AutomationProperties.Name="Selected NPC class" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="96"
                                            Style="{StaticResource QuietButton}" Content="_Choose..."
                                            Click="ChooseClass_Click"
                                            automation:AutomationProperties.Name="Choose NPC class" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Voice Type (optional)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="12,9" Background="#0E1924" CornerRadius="7">
                                        <TextBlock Text="{Binding Voice.Label, TargetNullValue=None}"
                                                   TextTrimming="CharacterEllipsis"
                                                   automation:AutomationProperties.Name="Selected NPC voice type" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="96"
                                            Style="{StaticResource QuietButton}" Content="_Choose..."
                                            Click="ChooseVoice_Click"
                                            automation:AutomationProperties.Name="Choose NPC voice type" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource MutedTextBrush}" Text="Combat Style (optional)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Padding="12,9" Background="#0E1924" CornerRadius="7">
                                        <TextBlock Text="{Binding CombatStyle.Label, TargetNullValue=None}"
                                                   TextTrimming="CharacterEllipsis"
                                                   automation:AutomationProperties.Name="Selected NPC combat style" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="96"
                                            Style="{StaticResource QuietButton}" Content="_Choose..."
                                            Click="ChooseCombatStyle_Click"
                                            automation:AutomationProperties.Name="Choose NPC combat style" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"
                       Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Style="{StaticResource QuietButton}" Content="Cancel"
                        IsCancel="True" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="Save identity"
                        IsDefault="True" Click="Accept_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
