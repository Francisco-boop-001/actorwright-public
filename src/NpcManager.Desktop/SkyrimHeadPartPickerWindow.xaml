<Window x:Class="NpcManager.Desktop.SkyrimHeadPartPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{Binding Title}"
        Width="1120" Height="720" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=FilterBox}"
        automation:AutomationProperties.Name="Choose a compatible Skyrim head part">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource EyebrowText}" Text="COMPATIBLE HDPT CATALOG" />
            <TextBlock Margin="0,5,0,0" FontSize="28" FontWeight="SemiBold"
                       Text="{Binding Title}" />
            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                       Text="{Binding Context}" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="Head part race sex and type context" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,14" Padding="14"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10">
            <TextBox x:Name="FilterBox"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     automation:AutomationProperties.Name="Filter compatible head parts"
                     automation:AutomationProperties.HelpText="Filter by EditorID, name, or FormID" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" MinWidth="500" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <ListView x:Name="HeadPartList"
                                  ItemsSource="{Binding VisibleRows}"
                                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                  Background="#0F1823" BorderThickness="0"
                                  MouseDoubleClick="HeadPartList_OnMouseDoubleClick"
                                  PreviewKeyDown="HeadPartList_OnPreviewKeyDown"
                                  automation:AutomationProperties.Name="Compatible Skyrim head parts">
                            <ListView.Resources>
                                <Style TargetType="{x:Type GridViewColumnHeader}">
                                    <Setter Property="Background" Value="#13252C" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="BorderBrush" Value="#294052" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                                <Style TargetType="{x:Type ListViewItem}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#184356" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="EditorID" Width="165"
                                                    DisplayMemberBinding="{Binding EditorId}" />
                                    <GridViewColumn Header="Name" Width="150"
                                                    DisplayMemberBinding="{Binding DisplayName}" />
                                    <GridViewColumn Header="FormID" Width="105"
                                                    DisplayMemberBinding="{Binding FormIdText}" />
                                    <GridViewColumn Header="Winning plugin" Width="150"
                                                    DisplayMemberBinding="{Binding PluginText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="380" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding EmptyState}"
                                   Visibility="{Binding HasNoVisibleRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   automation:AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="2,10,0,0" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding VisibleCount}" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowText}" Text="SELECTION AND PREVIEW" />
                        <TextBlock Margin="0,5,0,4" FontSize="22" FontWeight="SemiBold"
                                   Text="{Binding SelectionTitle}" TextWrapping="Wrap" />
                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding SelectionReference}" TextWrapping="Wrap"
                                   automation:AutomationProperties.Name="Selected head part reference" />
                        <TextBlock Margin="0,8,0,0" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="{Binding SelectionEvidence}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,14,0,12" Background="#09121B"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <TextBlock Margin="24" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Text="{Binding PreviewStatus}" TextWrapping="Wrap"
                                       automation:AutomationProperties.Name="Head part preview status"
                                       automation:AutomationProperties.LiveSetting="Polite" />
                            <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSource}}"
                                   Stretch="Uniform" SnapsToDevicePixels="True"
                                   Visibility="{Binding HasPreviewImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   automation:AutomationProperties.Name="Off-engine selected head part preview" />
                            <ProgressBar Height="4" VerticalAlignment="Top"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsPreviewBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2">
                        <TextBlock FontSize="11" Foreground="#E5B96A"
                                   Text="{Binding PreviewAuthority}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}"
                                   Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                                   automation:AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="110" Style="{StaticResource QuietButton}" Content="_Cancel"
                    IsCancel="True" Click="Cancel_OnClick"
                    automation:AutomationProperties.Name="Cancel head part selection" />
            <Button MinWidth="160" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Content="_Select head part"
                    IsDefault="True" IsEnabled="{Binding CanAccept}" Click="Accept_OnClick"
                    automation:AutomationProperties.Name="Select compatible head part" />
        </StackPanel>
    </Grid>
</Window>
