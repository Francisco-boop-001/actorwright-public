<Window x:Class="NpcManager.Desktop.ExistingNpcCollectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:local="clr-namespace:NpcManager.Desktop"
        Title="Edit NPC lists"
        Width="940" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=KeywordsGrid}"
        automation:AutomationProperties.Name="Existing NPC collection editor">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource EyebrowText}" Text="NPC LISTS" />
            <TextBlock Margin="0,5,0,4" FontSize="24" FontWeight="SemiBold"
                       Text="Edit gameplay collections" />
            <TextBlock Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="Each row is a typed Plugin.esp|0xFormID reference. Save returns one reviewed replacement; Cancel leaves the prior edit untouched." />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
            <TabControl automation:AutomationProperties.Name="NPC collection categories">
                <TabItem Header="Keywords">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DataGrid x:Name="KeywordsGrid" ItemsSource="{Binding Keywords}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  automation:AutomationProperties.Name="NPC keywords">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Reference" Width="*"
                                                    Binding="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Header="" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Style="{StaticResource QuietButton}"
                                                    Command="{Binding DataContext.RemoveKeywordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Content="Add keyword" Style="{StaticResource QuietButton}"
                                Command="{Binding AddKeywordCommand}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Factions">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Factions}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  automation:AutomationProperties.Name="NPC factions">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Faction reference" Width="*"
                                                    Binding="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Rank (-128…127)" Width="135"
                                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="76">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource QuietButton}"
                                                Command="{Binding DataContext.RemoveFactionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Content="Add faction" Style="{StaticResource QuietButton}"
                                Command="{Binding AddFactionCommand}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Inventory">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Inventory}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  automation:AutomationProperties.Name="NPC inventory">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item reference" Width="*"
                                                    Binding="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Signed count" Width="135"
                                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="76">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource QuietButton}"
                                                Command="{Binding DataContext.RemoveInventoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Content="Add item" Style="{StaticResource QuietButton}"
                                Command="{Binding AddInventoryCommand}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Outfits">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" /><ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Default outfit" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OutfitModes}"
                                          SelectedItem="{Binding DefaultOutfitMode}"
                                          automation:AutomationProperties.Name="Default outfit edit mode" />
                            <TextBox Grid.Column="3" Text="{Binding DefaultOutfitReference, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Default outfit reference">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DefaultOutfitMode}"
                                                         Value="{x:Static local:ExistingNpcOutfitEditMode.Set}">
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" /><ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="14" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Sleeping outfit" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OutfitModes}"
                                          SelectedItem="{Binding SleepingOutfitMode}"
                                          automation:AutomationProperties.Name="Sleeping outfit edit mode" />
                            <TextBox Grid.Column="3" Text="{Binding SleepingOutfitReference, UpdateSourceTrigger=PropertyChanged}"
                                     automation:AutomationProperties.Name="Sleeping outfit reference">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SleepingOutfitMode}"
                                                         Value="{x:Static local:ExistingNpcOutfitEditMode.Set}">
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            </Grid>
                        </Border>
                        <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Keep preserves the source value. Set requires a typed reference. Clear writes no outfit link." />
                    </StackPanel>
                </TabItem>

                <TabItem Header="Perks">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Perks}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  automation:AutomationProperties.Name="NPC perks">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Perk reference" Width="*"
                                                    Binding="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Rank (0…255)" Width="135"
                                                    Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="76">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource QuietButton}"
                                                Command="{Binding DataContext.RemovePerkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Content="Add perk" Style="{StaticResource QuietButton}"
                                Command="{Binding AddPerkCommand}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Actor effects">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding ActorEffects}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  automation:AutomationProperties.Name="NPC actor effects">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Spell reference" Width="*"
                                                    Binding="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTemplateColumn Width="76">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource QuietButton}"
                                                Command="{Binding DataContext.RemoveActorEffectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Content="Add actor effect" Style="{StaticResource QuietButton}"
                                Command="{Binding AddActorEffectCommand}" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"
                       Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                       automation:AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Content="Cancel" IsCancel="True"
                        Style="{StaticResource QuietButton}" Click="Cancel_Click" />
                <Button Content="Save list changes" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Accept_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
